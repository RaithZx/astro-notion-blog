---
import type { Post } from '../lib/interfaces.ts'
import { getPostLink, getNavLink } from '../lib/blog-helpers.ts'
import { getImageFromNotionUrl } from '../lib/image-helpers.ts'
import ImageWithBlur from './ImageWithBlur.astro'

export interface Props {
  posts: Post[]
  currentPostSlug: string
  title?: string
}

const { posts, currentPostSlug, title = 'Ler di Sigida' } = Astro.props

const relatedPosts = posts
  .filter((p: Post) => p.Slug !== currentPostSlug)
  .slice(0, 3)

const loadPostImage = (post: Post) => {
  if (!post.FeaturedImage?.Url) return null
  if (import.meta.env.DEV) {
    return post.FeaturedImage.Url
  }
  const imported = getImageFromNotionUrl(new URL(post.FeaturedImage.Url))
  return imported || post.FeaturedImage.Url
}

const relatedPostsImages = relatedPosts.map(loadPostImage)
---

{
  relatedPosts.length > 0 && (
    <section class="mt-24 md:mt-32 pb-20 px-0">
      <div class="flex flex-col sm:flex-row sm:justify-between sm:items-end gap-6 mb-12">
        <div>
          <h2 class="text-display-md font-headline mb-2 text-on-background">{title}</h2>
          <p class="text-body-lg text-on-surface-variant">Kontinuia bu jornada di diskuberta digital</p>
        </div>
        <a
          href={getNavLink('/')}
          class="inline-flex items-center gap-2 shrink-0 self-start sm:self-auto text-primary font-bold text-sm no-underline hover:underline underline-offset-4 decoration-tertiary"
        >
          Odja tudu artigu
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
        {
          relatedPosts.map((relatedPost: Post, index: number) => {
            const image = relatedPostsImages[index]
            return (
              <a href={getPostLink(relatedPost.Slug)} class="group block no-underline rounded-2xl overflow-hidden transition-transform duration-300 hover:-translate-y-0.5">
                {image && (
                  <div class="h-64 overflow-hidden rounded-2xl mb-6 bg-on-surface/[0.06]">
                    <ImageWithBlur
                      src={image}
                      alt={relatedPost.Title}
                      width={typeof image === 'string' ? undefined : image.width}
                      height={typeof image === 'string' ? undefined : image.height}
                      loading="lazy"
                      aspectRatio="16/9"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  </div>
                )}
                <div class="space-y-4 px-1">
                  {relatedPost.Tags && relatedPost.Tags.length > 0 && (
                    <span class="text-tertiary font-bold text-label-md uppercase tracking-widest block">
                      {relatedPost.Tags[0].name}
                    </span>
                  )}
                  <h3 class="text-xl font-bold font-headline text-on-background group-hover:text-primary transition-colors leading-tight m-0">
                    {relatedPost.Title}
                  </h3>
                </div>
              </a>
            )
          })
        }
      </div>
    </section>
  )
}
