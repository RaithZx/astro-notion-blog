---
import type { Block } from '../lib/interfaces.ts'
import NotionBlocks from './NotionBlocks.astro'

export interface Props {
  blocks: Block[]
}

const { blocks } = Astro.props
---

<div class="article-body" style="max-width: 100%; overflow-x: hidden; word-wrap: break-word; overflow-wrap: break-word;">
  <NotionBlocks blocks={blocks} isRoot={true} level={1} headings={[]} />
</div>

<style is:global>
  .article-body p {
    font-size: 1.125rem;
    line-height: 1.8;
    color: #424754;
  }
  .article-body > :first-child p {
    font-size: 1.5rem;
    line-height: 1.6;
    color: #0b1c30;
  }
  .article-body h2 {
    font-size: 1.875rem;
    font-weight: 700;
    padding-top: 2rem;
    color: #0b1c30;
  }
  .article-body h3 {
    font-size: 1.5rem;
    font-weight: 700;
    padding-top: 1.5rem;
    color: #006577;
  }
  /* Deep dive callout — tertiary + glass, no 1px rule (DESIGN.md §5) */
  .article-body blockquote {
    background-color: rgba(0, 128, 150, 0.12);
    backdrop-filter: blur(8px);
    padding: 2.5rem;
    border-radius: 1.5rem;
    margin: 3rem 0;
    border: none;
    box-shadow: inset 0 0 0 1px rgba(194, 198, 214, 0.15);
  }
  .article-body blockquote p {
    font-size: 1.5rem;
    font-family: 'Space Grotesk', sans-serif;
    font-style: italic;
    color: #004e5c;
    line-height: 1.4;
  }
  .article-body a {
    color: #0058be;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: #d8e2ff;
    transition: text-decoration-color 0.2s;
  }
  .article-body a:hover {
    text-decoration-color: #0058be;
  }
  .article-body img {
    border-radius: 1.5rem;
    margin: 2rem 0;
  }
  .article-body pre {
    border-radius: 1rem;
    margin: 2rem 0;
  }
  .article-body ul, .article-body ol {
    color: #424754;
    font-size: 1.125rem;
    line-height: 1.8;
  }
</style>
