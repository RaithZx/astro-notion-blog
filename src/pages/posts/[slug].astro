---
export const prerender = true

import * as interfaces from '../../lib/interfaces.ts'
import ImageWithBlur from '../../components/ImageWithBlur.astro'
import {
  getPosts,
  getAllPosts,
  getRankedPosts,
  getPostBySlug,
  getPostsByTag,
  getBlock,
  getAllTags,
  getAllBlocksByBlockId,
  downloadFile,
} from '../../lib/notion/client.ts'
import {
  getPostLink,
  filePath,
  extractTargetBlocks,
  getDateStr,
  getNavLink,
} from '../../lib/blog-helpers.ts'
import { getImageFromNotionUrl } from '../../lib/image-helpers.ts'
import Layout from '../../layouts/Layout.astro'
import PostDate from '../../components/PostDate.astro'
import PostTags from '../../components/PostTags.astro'
import PostBody from '../../components/PostBody.astro'
import PostFeaturedImage from '../../components/PostFeaturedImage.astro'
import NoContents from '../../components/NoContents.astro'
import ShareButtons from '../../components/ShareButtons.astro'
import RelatedArticles from '../../components/RelatedArticles.astro'
import SubscribeBanner from '../../components/subscribeBanner.astro'

export async function getStaticPaths() {
  const posts = await getAllPosts()
  return posts.map((post: interfaces.Post) => ({ params: { slug: post.Slug } }))
}

const { slug } = Astro.params

const post = await getPostBySlug(slug)
if (!post) {
  throw new Error(`Post not found. slug: ${slug}`)
}

const [blocks, allPosts, rankedPosts, recentPosts, tags, postsHavingSameTag] =
  await Promise.all([
    getAllBlocksByBlockId(post.PageId),
    getAllPosts(),
    getRankedPosts(),
    getPosts(5),
    getAllTags(),
    getPostsByTag(post.Tags[0]?.name, 6),
  ])

const currentPostIndex = allPosts.findIndex((post) => post.Slug === slug)
const prevPost = allPosts[currentPostIndex + 1]
const nextPost = allPosts[currentPostIndex - 1]

let ogImage = ''
if (post.FeaturedImage && post.FeaturedImage.Url) {
  ogImage = new URL(filePath(new URL(post.FeaturedImage.Url)), Astro.site).toString()
}

function formatDateShort(date: string): string {
  const dt = new Date(date)
  const months = ['Jan', 'Feb', 'Mar', 'Abr', 'Maiu', 'Jun', 'Jul', 'Ago', 'Set', 'Otu', 'Nov', 'Diz']
  const day = dt.getDate()
  const month = months[dt.getMonth()]
  const year = dt.getFullYear()
  return `${day} ${month} ${year}`
}

function estimateReadingTime(excerpt: string): string {
  const words = excerpt.split(/\s+/).length
  const minutes = Math.max(1, Math.ceil(words / 200))
  return `${minutes} min`
}
---

<Layout
  title={post.Title}
  description={post.Excerpt}
  path={getPostLink(post.Slug)}
  ogImage={ogImage}
  fullWidth={true}
>
  <div slot="main">
    <!-- Article Header Section -->
    <article class="relative px-0">
      <div class="flex flex-col md:flex-row gap-8 md:gap-12 mb-16 md:items-end">
        <!-- Left: Tags, Title, Excerpt -->
        <div class="flex-1 space-y-6">
          <div class="flex flex-wrap gap-3 items-center">
            <PostTags post={post} />
            {post.Excerpt && (
              <span class="text-on-surface-variant text-xs font-medium py-1">
                {estimateReadingTime(post.Excerpt)} di leitura
              </span>
            )}
          </div>
          <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold leading-[1.1] tracking-tight text-on-background font-headline">
            {post.Icon && post.Icon.Type === 'emoji' && 'Emoji' in post.Icon && (
              <span class="inline-block mr-2 text-[0.85em]">{post.Icon.Emoji}</span>
            )}
            {post.Title}
          </h1>
          {post.Excerpt && (
            <p class="text-lg md:text-xl text-on-surface-variant font-light max-w-2xl leading-relaxed">
              {post.Excerpt}
            </p>
          )}
        </div>
        
        <!-- Right: Date & Share -->
        <div class="md:w-1/3 space-y-4 border-l-2 border-primary-fixed pl-6 pb-2">
          <div>
            {post.Date && (
              <p class="font-bold text-on-surface m-0">{formatDateShort(post.Date)}</p>
            )}
            {post.Tags && post.Tags.length > 0 && (
              <p class="text-sm text-on-surface-variant m-0 mt-1">{post.Tags[0].name}</p>
            )}
          </div>
          <ShareButtons 
            title={post.Title}
            path={getPostLink(post.Slug)}
            description={post.Excerpt}
            variant="compact"
          />
        </div>
      </div>
    </article>

    <!-- Hero Image - Full bleed on mobile, constrained on desktop -->
    {post.FeaturedImage?.Url && (
      <div class="w-full md:max-w-7xl md:mx-auto h-[300px] sm:h-[400px] md:h-[614px] md:rounded-[2rem] overflow-hidden mb-12 md:mb-20 shadow-ambient">
        <PostFeaturedImage post={post} loading="eager" />
      </div>
    )}

    <!-- Body Content with social sidebar -->
    <article class="px-0">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
        <!-- Social Side Bar (desktop only) -->
        <aside class="md:col-span-1 hidden md:flex flex-col gap-8 sticky top-32 h-fit">
          <div class="w-px h-24 bg-primary-fixed mx-auto"></div>
          <a
            href="#"
            class="share-sidebar-twitter text-on-surface-variant hover:text-primary transition-colors flex justify-center"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Partilha na Twitter"
            data-path={getPostLink(post.Slug)}
            data-title={post.Title}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path>
            </svg>
          </a>
          <a
            href="#"
            class="share-sidebar-facebook text-on-surface-variant hover:text-primary transition-colors flex justify-center"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Partilha na Facebook"
            data-path={getPostLink(post.Slug)}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
          <a
            href="#"
            class="share-sidebar-whatsapp text-on-surface-variant hover:text-primary transition-colors flex justify-center"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Partilha na WhatsApp"
            data-path={getPostLink(post.Slug)}
            data-title={post.Title}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path>
              <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"></path>
            </svg>
          </a>
          <button
            class="share-sidebar-copy text-on-surface-variant hover:text-primary transition-colors flex justify-center bg-transparent border-0 cursor-pointer p-0"
            aria-label="Kopia link"
            data-path={getPostLink(post.Slug)}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
          </button>
        </aside>
        
        <!-- Article Text -->
        <div class="md:col-span-8 md:col-start-3">
          {blocks && blocks.length > 0 ? (
            <PostBody blocks={blocks} />
          ) : (
            <NoContents contents={[]} />
          )}
        </div>
      </div>
    </article>
    
    <!-- Article end marker for scroll tracking -->
    <div id="article-content-end" style="height: 1px;"></div>
    
    <!-- Tags -->
    <div class="px-0 max-w-3xl mx-auto mt-12 mb-8 pt-8">
      <PostTags post={post} />
    </div>

    <!-- Newsletter Subscription Banner -->
    <div class="px-0 max-w-3xl mx-auto">
      <SubscribeBanner />
    </div>

    <!-- Read Next Section -->
    <RelatedArticles 
      posts={postsHavingSameTag.length > 0 ? postsHavingSameTag : rankedPosts}
      currentPostSlug={post.Slug}
      title="Ler di Sigida"
    />
  </div>
</Layout>

<script>
  document.querySelectorAll('.share-sidebar-twitter').forEach((el) => {
    const path = el.getAttribute('data-path') || ''
    const title = el.getAttribute('data-title') || ''
    const fullUrl = window.location.origin + path
    el.setAttribute('href', `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(fullUrl)}`)
  })
  document.querySelectorAll('.share-sidebar-facebook').forEach((el) => {
    const path = el.getAttribute('data-path') || ''
    const fullUrl = window.location.origin + path
    el.setAttribute('href', `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(fullUrl)}`)
  })
  document.querySelectorAll('.share-sidebar-whatsapp').forEach((el) => {
    const path = el.getAttribute('data-path') || ''
    const title = el.getAttribute('data-title') || ''
    const fullUrl = window.location.origin + path
    el.setAttribute('href', `https://wa.me/?text=${encodeURIComponent(title)}%20${encodeURIComponent(fullUrl)}`)
  })
  document.querySelectorAll('.share-sidebar-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const path = btn.getAttribute('data-path') || ''
      const fullUrl = window.location.origin + path
      try {
        await navigator.clipboard.writeText(fullUrl)
        ;(btn as HTMLElement).style.color = '#006577'
        setTimeout(() => { (btn as HTMLElement).style.color = '' }, 2000)
      } catch (err) {
        console.error('Failed to copy:', err)
      }
    })
  })
</script>
