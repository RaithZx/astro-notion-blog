---
export const prerender = true

import type { SelectProperty } from '../../../lib/interfaces.ts'
import {
  getPostsByTag,
  getAllTags,
  getPostCountByTag,
} from '../../../lib/notion/client.ts'
import Layout from '../../../layouts/Layout.astro'
import CategoryTagMain from '../../../components/CategoryTagMain.astro'

export async function getStaticPaths() {
  const allTags = await getAllTags()
  return allTags.map((t: SelectProperty) => ({ params: { tag: t.name } }))
}

const { tag } = Astro.params

const [posts, tags, totalInTag] = await Promise.all([
  getPostsByTag(tag, 9999),
  getAllTags(),
  getPostCountByTag(tag),
])
---

<Layout
  title={`${tag} | Ligadu`}
  description={`Artigus di ${tag}`}
  path={`/posts/tag/${tag}`}
  ogImage=""
  fullWidth={true}
  showCategoryNav={false}
>
  <div slot="main" class="w-full min-w-0">
    <CategoryTagMain
      tag={tag}
      posts={posts}
      currentPage={1}
      numberOfPages={1}
      totalInTag={totalInTag}
      allTags={tags}
      useLoadMore={true}
    />
  </div>
</Layout>
