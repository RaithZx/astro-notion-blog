# Newsletter API Configuration
# Copy this to your .env file

# Development: Point to local API service
NEWSLETTER_API_URL=http://localhost:3001

# Production: Leave empty or use relative path
# NEWSLETTER_API_URL=
# (Coolify will proxy /api/subscribe to tek-newsletter-api:3001)

# Clerk — reader sign-in (Entra) and automatic newsletter registration
# https://dashboard.clerk.com → API Keys
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...  # required with output:server + clerkMiddleware (Clerk server APIs)
