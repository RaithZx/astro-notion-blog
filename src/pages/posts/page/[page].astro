---
export const prerender = true

import {
  getPostsByPage,
  getAllTags,
  getNumberOfPages,
  getAllPosts,
} from '../../../lib/notion/client.ts'
import Layout from '../../../layouts/Layout.astro'
import CategoryTagMain from '../../../components/CategoryTagMain.astro'
import uiStrings from '../../../locales/ui-strings.json'

export async function getStaticPaths() {
  const numberOfPages = await getNumberOfPages()
  const maxPage = Math.max(1, numberOfPages)
  const params = []
  for (let i = 1; i <= maxPage; i++) {
    params.push({ params: { page: i.toString() } })
  }
  return params
}

const { page } = Astro.params
const currentPage = parseInt(page ?? '1', 10)

const [posts, tags, numberOfPages, allPostsList] = await Promise.all([
  getPostsByPage(currentPage),
  getAllTags(),
  getNumberOfPages(),
  getAllPosts(),
])

const pageCount = Math.max(1, numberOfPages)
const totalAllPosts = allPostsList.length
const app = uiStrings.app
const brand = app.layout.brandName
const pageTitle =
  currentPage > 1
    ? app.allPostsPage.titlePage.replace('{{page}}', String(currentPage)).replace('{{brand}}', brand)
    : app.allPostsPage.titleAll.replace('{{brand}}', brand)
---

<Layout
  title={pageTitle}
  description={app.site.homeDescription}
  path={`/posts/page/${page}`}
  ogImage=""
  fullWidth={true}
  showCategoryNav={false}
>
  <div slot="main" class="w-full min-w-0">
    <CategoryTagMain
      tag=""
      posts={posts}
      currentPage={currentPage}
      numberOfPages={pageCount}
      totalInTag={totalAllPosts}
      allTags={tags}
      allPostsArchive={true}
    />
  </div>
</Layout>
