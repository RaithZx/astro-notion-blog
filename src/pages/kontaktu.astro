---
export const prerender = true

import Layout from '../layouts/Layout.astro'
import { getDatabase } from '../lib/notion/client.ts'
import uiStrings from '../locales/ui-strings.json'

const database = await getDatabase()
---

<Layout
  title={uiStrings.app.kontaktu.pageTitle}
  description={uiStrings.app.kontaktu.pageDescription}
  path="/kontaktu"
  ogImage=""
>
  <div slot="main">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold font-headline text-on-surface mb-8">Nos Kontaktu</h1>

      <div class="mb-12">
        <!-- Contact Information -->
        <div class="space-y-6">
          <h2 class="text-2xl font-semibold font-headline text-on-surface mb-4">Informason di Kontaktu</h2>

          <div class="space-y-4">
            <div class="flex items-start space-x-3">
              <div class="text-2xl">📧</div>
              <div>
                <h3 class="font-semibold text-on-surface">Email</h3>
                <p class="text-on-surface-variant">kontaktu [at] ligadu [dot] com</p>
              </div>
            </div>

            <div class="flex items-start space-x-3">
              <div class="text-2xl">🌐</div>
              <div>
                <h3 class="font-semibold text-on-surface">Website</h3>
                <p class="text-on-surface-variant">www.ligadu.com</p>
              </div>
            </div>

            <div class="flex items-start space-x-3">
              <div class="text-2xl">💼</div>
              <div>
                <h3 class="font-semibold text-on-surface">LinkedIn</h3>
                <a href="#" class="text-primary hover:text-primary transition-colors">Ligadu</a>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- FAQ Section -->
      <div class="bg-surface-container-low rounded-xl p-6">
        <h2 class="text-2xl font-semibold font-headline text-on-surface mb-6">Perguntas ki kustuma ta fazedu</h2>

        <div class="space-y-4">
          <div>
            <h3 class="font-semibold text-on-surface mb-2">N pode da algun sujiston di artigus pa publika?</h3>
            <p class="text-on-surface-variant">Klaru! Nu gosta di resebe sujistons di artigus pa publika. Manda bus sujeston i nu ta odja si ta da pa publika ô nau.</p>
          </div>

          <div>
            <h3 class="font-semibold text-on-surface mb-2">Modi ki N pode resebe artigus i otus informason sobri "Ligadu"?</h3>
            <p class="text-on-surface-variant">Klika na buton "Inskreve" na parti di riba di pájina i poi bu informason di kontaktu. É di grasa!</p>
          </div>

          <div>
            <h3 class="font-semibold text-on-surface mb-2">Bu tene algun prublema tékniku ku nos site?</h3>
            <p class="text-on-surface-variant">Si bu tene algun prublema tékniku, manda nu un email ta splika kal ki é prublema i nu ta resolve-l mas rápidu posível.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

</Layout>
