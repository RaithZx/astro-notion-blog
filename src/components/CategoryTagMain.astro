---
/**
 * Category / tag archive — Stitch “Teknolodjia” layout: editorial hero, tag pills,
 * featured + grid feed, newsletter sidebar.
 */
import { Image } from 'astro:assets'
import type { Post, SelectProperty } from '../lib/interfaces.ts'
import { getNavLink, getPostLink } from '../lib/blog-helpers.ts'
import { getImageFromNotionUrl } from '../lib/image-helpers.ts'
import CategoryPill from './CategoryPill.astro'
import Pagination from './Pagination.astro'
import PostCard from './PostCard.astro'
import uiStrings from '../locales/ui-strings.json'
const ca = uiStrings.app.categoryArchive

export interface Props {
  /** Tag name when viewing a category; use '' when `allPostsArchive` is true */
  tag: string
  posts: Post[]
  currentPage: number
  numberOfPages: number
  /** Total posts in scope (in-tag count or site-wide count for all archive) */
  totalInTag: number
  allTags: SelectProperty[]
  /** Full post list at `/posts/page/N` — same chrome as tag archives, "Tudu" pill active */
  allPostsArchive?: boolean
  /** Replace pagination with a load-more button (all posts pre-rendered, toggled client-side) */
  useLoadMore?: boolean
}

const GRID_INITIAL = 8

const {
  tag,
  posts,
  currentPage,
  numberOfPages,
  totalInTag,
  allTags,
  allPostsArchive = false,
  useLoadMore = false,
} = Astro.props

const paginationTag = allPostsArchive ? '' : tag
const headerLabel = allPostsArchive ? ca.allLabel : tag



const loadPostImage = (post: Post) => {
  if (!post.FeaturedImage?.Url) return null
  if (import.meta.env.DEV) return post.FeaturedImage.Url
  const imported = getImageFromNotionUrl(new URL(post.FeaturedImage.Url))
  return imported || post.FeaturedImage.Url
}

const featuredPost = currentPage === 1 && posts.length > 0 ? posts[0] : null
const featuredImage = featuredPost ? loadPostImage(featuredPost) : null
const gridPosts =
  currentPage === 1 && posts.length > 1 ? posts.slice(1) : currentPage > 1 ? posts : []

const allPostsIndexPath = getNavLink('/posts/page/1')
---

<div class="w-full pb-24">
  <!-- Editorial header -->
  <section class="mb-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
      <div class="max-w-2xl">
        <h1
          class="text-5xl sm:text-6xl md:text-7xl font-black font-headline tracking-tighter text-on-surface leading-none m-0"
        >
          {headerLabel}.
        </h1>
      </div>
    </div>
  </section>

  <!-- Tag pills -->
  <div class="relative mb-6">
    <div class="flex gap-2 overflow-x-auto py-3" data-scroll-fade style="scrollbar-width: none; -ms-overflow-style: none;">
    <a
      href={allPostsIndexPath}
      class:list={[
        'shrink-0 inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm no-underline transition-all duration-200 border',
        allPostsArchive
          ? 'bg-primary/10 text-primary border-primary/40 font-semibold'
          : 'font-medium bg-surface-container-lowest border-outline-variant/20 text-on-surface hover:bg-surface-container hover:border-primary/30 hover:text-primary dark:bg-surface-container-high dark:border-outline-variant/40 dark:hover:bg-surface-container-highest',
      ]}
    >
      {ca.allLabel}
    </a>
    {allTags.map((t) => (
      <CategoryPill name={t.name} active={!allPostsArchive && t.name === tag} />
    ))}
    </div>
    <div class="scroll-fade-left absolute inset-y-0 left-0 w-8 bg-gradient-to-r from-surface to-transparent pointer-events-none opacity-0 transition-opacity" aria-hidden="true" />
    <div class="scroll-fade-right absolute inset-y-0 right-0 w-8 bg-gradient-to-l from-surface to-transparent pointer-events-none transition-opacity" aria-hidden="true" />
  </div>

  <div class="w-full space-y-16">
    {
      totalInTag === 0 ? (
        <div class="bg-surface-container-low rounded-lg p-12 text-center">
          <p class="text-on-surface-variant text-lg m-0 mb-6">
            {allPostsArchive ? ca.noPostsAll : ca.noPostsCategory}
          </p>
          {!allPostsArchive && (
            <a
              href={allPostsIndexPath}
              class="inline-flex items-center gap-2 text-primary font-bold no-underline hover:underline underline-offset-4 decoration-2"
            >
              {ca.viewAllPosts}
              <span class="material-symbols-outlined !text-lg" aria-hidden="true">arrow_forward</span>
            </a>
          )}
        </div>
      ) : (
        <>
          {featuredPost && (
            <article class="group mb-12">
              <a href={getPostLink(featuredPost.Slug)} class="block no-underline">
                <div class="rounded-xl overflow-hidden relative h-[380px] md:h-[500px] bg-surface-container-high transition-shadow duration-300 group-hover:shadow-ambient">
                  {featuredImage ? (
                    <div class="absolute inset-0 group-hover:scale-105 transition-transform duration-700">
                      {typeof featuredImage === 'string' ? (
                        <img
                          src={featuredImage}
                          alt={featuredPost.Title}
                          class="w-full h-full object-cover"
                          loading="eager"
                        />
                      ) : (
                        <Image
                          src={featuredImage}
                          alt={featuredPost.Title}
                          class="w-full h-full object-cover"
                          loading="eager"
                        />
                      )}
                    </div>
                  ) : (
                    <div class="absolute inset-0 bg-gradient-to-br from-primary/20 via-surface-container to-tertiary/15" />
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent pointer-events-none" />
                  <div class="absolute bottom-0 left-0 right-0 px-6 pb-7 pt-16 md:px-10 md:pb-9">
                    {featuredPost.Tags && featuredPost.Tags.length > 0 && (
                      <div class="flex flex-wrap gap-3 mb-3">
                        {featuredPost.Tags.slice(0, 3).map((t) => (
                          <span class="text-tertiary-fixed font-bold text-[10px] uppercase tracking-widest">
                            {t.name}
                          </span>
                        ))}
                      </div>
                    )}
                    <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold font-headline text-white leading-tight mb-3 m-0">
                      {featuredPost.Title}
                    </h2>
                    {featuredPost.Excerpt && (
                      <p class="text-sm md:text-base text-white/75 max-w-2xl leading-relaxed m-0 line-clamp-2">
                        {featuredPost.Excerpt}
                      </p>
                    )}
                  </div>
                </div>
              </a>
            </article>
          )}

          {gridPosts.length > 0 && (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 md:gap-12" id="tag-grid">
              {gridPosts.map((post, i) => (
                <div class:list={[useLoadMore && i >= GRID_INITIAL && 'tag-extra hidden']}>
                  <PostCard post={post} />
                </div>
              ))}
            </div>
          )}

          {useLoadMore && gridPosts.length > GRID_INITIAL && (
            <div class="flex justify-center mt-8">
              <button
                id="tag-load-more-btn"
                type="button"
                class="flex items-center gap-2 px-8 py-3 rounded-full border-2 border-outline-variant text-on-surface font-bold hover:border-primary hover:text-primary transition-colors"
                data-label-more={ca.loadMore}
                data-label-less={ca.showLess}
              >
                {ca.loadMore}
                <span class="material-symbols-outlined text-lg" id="tag-load-more-icon">expand_more</span>
              </button>
            </div>
          )}

          {!useLoadMore && numberOfPages > 1 && (
            <div class="pt-4">
              <Pagination
                tag={paginationTag}
                currentPage={currentPage}
                numberOfPages={numberOfPages}
              />
            </div>
          )}
        </>
      )
    }
  </div>
</div>

<script>
  import { initScrollFade } from '../lib/scroll-fade-init'
  initScrollFade()

  const btn = document.getElementById('tag-load-more-btn') as HTMLButtonElement | null
  const icon = document.getElementById('tag-load-more-icon')
  const extras = document.querySelectorAll<HTMLElement>('.tag-extra')

  if (btn && extras.length > 0) {
    let expanded = false
    const labelMore = btn.dataset.labelMore ?? ''
    const labelLess = btn.dataset.labelLess ?? ''

    btn.addEventListener('click', () => {
      expanded = !expanded
      extras.forEach((el) => el.classList.toggle('hidden', !expanded))
      const textNode = btn.firstChild as Text
      if (textNode?.nodeType === Node.TEXT_NODE) textNode.data = expanded ? labelLess : labelMore
      if (icon) icon.textContent = expanded ? 'expand_less' : 'expand_more'
    })
  }
</script>
