---
import type { Post, SelectProperty } from '../lib/interfaces.ts'
import { getTagLink } from '../lib/blog-helpers.ts'
import '../styles/notion-color.css'

export interface Props {
  post: Post
  enableLink?: boolean
}

const { post, enableLink = true } = Astro.props
---

<div class="text-sm flex flex-wrap gap-2">
  {
    post.Tags &&
      post.Tags.length > 0 &&
      post.Tags.map((tag: SelectProperty) => {
        if (enableLink) {
          return (
            <a href={getTagLink(tag.name)} class="ds-chip hover:bg-primary-fixed transition-colors">
              {tag.name}
            </a>
          )
        }
        return <span class="ds-chip">{tag.name}</span>
      })
  }
</div>
