---
import type { Post } from '../lib/interfaces.ts'
import { getNavLink } from '../lib/blog-helpers.ts'
import PostCard from './PostCard.astro'
import uiStrings from '../locales/ui-strings.json'

export interface Props {
  posts: Post[]
  title?: string
}

const { posts, title = uiStrings.app.post.latestHeading } = Astro.props
---

{
  posts.length > 0 && (
    <section class="pb-16 border-t border-outline-variant/25 pt-10">
      <div class="flex items-center justify-between gap-3 mb-6">
        <h2 class="font-headline text-xl font-bold text-outline m-0">{title}</h2>
        <a
          href={getNavLink('/posts/page/1')}
          class="inline-flex items-center gap-1 shrink-0 text-primary font-bold text-sm no-underline hover:underline underline-offset-4 decoration-tertiary"
        >
          {uiStrings.app.post.viewAll}
          <span class="material-symbols-outlined text-lg">chevron_right</span>
        </a>
      </div>
      <div class="flex flex-col gap-4">
        {posts.map((post) => (
          <PostCard post={post} variant="list" loading="lazy" />
        ))}
      </div>
    </section>
  )
}
