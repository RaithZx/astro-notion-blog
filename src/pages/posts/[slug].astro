---
import {
  getAllPosts,
  getRankedPosts,
  getPostBySlug,
  getAllBlocksByBlockId,
} from '../../lib/notion/client.ts'
import {
  getPostLink,
  filePath,
} from '../../lib/blog-helpers.ts'
import Layout from '../../layouts/Layout.astro'
import PostTags from '../../components/PostTags.astro'
import PostBody from '../../components/PostBody.astro'
import PostFeaturedImage from '../../components/PostFeaturedImage.astro'
import NoContents from '../../components/NoContents.astro'
import RelatedArticles from '../../components/RelatedArticles.astro'
import LatestPosts from '../../components/LatestPosts.astro'
import ContentGate from '../../components/ContentGate.astro'
import AdUnit from '../../components/AdUnit.astro'
import uiStrings from '../../locales/ui-strings.json'

const { slug } = Astro.params
const { userId } = Astro.locals.auth()
const isSignedIn = !!userId

const post = await getPostBySlug(slug)
if (!post) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const [allPosts, rankedPosts, blocks] = await Promise.all([
  getAllPosts(),
  getRankedPosts(),
  getAllBlocksByBlockId(post.PageId),
])

type Block = (typeof blocks)[number]
type BlockAcc = { collected: Block[]; words: number }

function blockWords(block: Block): number {
  const richTexts =
    block.Paragraph?.RichTexts ??
    block.Heading1?.RichTexts ??
    block.Heading2?.RichTexts ??
    block.Heading3?.RichTexts ??
    block.Quote?.RichTexts ??
    []
  return richTexts.reduce((n, rt) => n + rt.PlainText.trim().split(/\s+/).filter(Boolean).length, 0)
}

function countTotalWords(source: Block[]): number {
  return source.reduce((total, block) => {
    if (['paragraph', 'heading_1', 'heading_2', 'heading_3', 'quote'].includes(block.Type)) {
      return total + blockWords(block)
    }
    if (block.Type === 'column_list' && block.ColumnList) {
      return total + block.ColumnList.Columns.reduce((s, col) => s + countTotalWords(col.Children), 0)
    }
    return total
  }, 0)
}

function blockPlainText(block: Block): string {
  const richTexts =
    block.Paragraph?.RichTexts ??
    block.Heading1?.RichTexts ??
    block.Heading2?.RichTexts ??
    block.Heading3?.RichTexts ??
    block.Quote?.RichTexts ??
    []
  return richTexts.map((rt) => rt.PlainText).join('')
}

function collectByWords(source: Block[], wordLimit: number, excerpt: string, acc: BlockAcc = { collected: [], words: 0 }): BlockAcc {
  for (const block of source) {
    if (acc.words >= wordLimit) break
    if (['paragraph', 'heading_1', 'heading_2', 'heading_3', 'quote'].includes(block.Type)) {
      const text = blockPlainText(block).trim()
      if (excerpt && text === excerpt.trim()) continue
      acc.collected.push({ ...block, HasChildren: false })
      acc.words += blockWords(block)
    } else if (block.Type === 'column_list' && block.ColumnList) {
      for (const col of block.ColumnList.Columns) {
        collectByWords(col.Children, wordLimit, excerpt, acc)
        if (acc.words >= wordLimit) break
      }
    } else if (block.Type === 'synced_block' && block.SyncedBlock?.Children) {
      collectByWords(block.SyncedBlock.Children, wordLimit, excerpt, acc)
    } else if (block.Type === 'toggle' && block.Toggle?.Children) {
      collectByWords(block.Toggle.Children, wordLimit, excerpt, acc)
    } else if (block.Type === 'callout' && block.Callout?.Children) {
      collectByWords(block.Callout.Children, wordLimit, excerpt, acc)
    }
  }
  return acc
}

const totalWords = countTotalWords(blocks)
const previewWordLimit = Math.max(100, Math.floor(totalWords * 0.2))
const previewBlocks = isSignedIn ? [] : collectByWords(blocks, previewWordLimit, post.Excerpt).collected

// Related posts scored by tag overlap across all of the post's tags, not just the first one
const postTagNames = new Set(post.Tags.map((tag) => tag.name))
const relatedPosts = allPosts
  .filter((p) => p.Slug !== post.Slug)
  .map((p) => ({
    post: p,
    overlap: p.Tags.filter((tag) => postTagNames.has(tag.name)).length,
  }))
  .filter((entry) => entry.overlap > 0)
  .sort((a, b) => b.overlap - a.overlap)
  .slice(0, 6)
  .map((entry) => entry.post)

const shownRelatedSlugs = new Set([post.Slug, ...relatedPosts.slice(0, 3).map((p) => p.Slug)])
const latestForSection = allPosts
  .filter((p) => !shownRelatedSlugs.has(p.Slug))
  .slice(0, 4)

let ogImage = ''
if (post.FeaturedImage && post.FeaturedImage.Url) {
  ogImage = new URL(filePath(new URL(post.FeaturedImage.Url)), Astro.site).toString()
}

function formatDateShort(date: string): string {
  const dt = new Date(date)
  const months = ['Jan', 'Feb', 'Mar', 'Abr', 'Maiu', 'Jun', 'Jul', 'Ago', 'Set', 'Otu', 'Nov', 'Diz']
  const day = dt.getDate()
  const month = months[dt.getMonth()]
  const year = dt.getFullYear()
  return `${day} ${month} ${year}`
}

function estimateReadTime(blockCount: number): number {
  return Math.max(1, Math.ceil((blockCount * 30) / 220))
}
const readTime = isSignedIn ? estimateReadTime(blocks.length) : null

---

<Layout
  title={post.Title}
  description={post.Excerpt}
  path={getPostLink(post.Slug)}
  ogImage={ogImage}
  fullWidth={true}
>
  <div slot="main">
    <!-- Reading progress bar -->
    <div
      id="reading-progress"
      class="fixed top-0 left-0 h-1 bg-primary z-[100] motion-reduce:transition-none"
      style="width: 0%;"
    ></div>

    <!-- Article Header: tag → title → excerpt → metadata row -->
    <article id="article-start" class="max-w-[44rem] mx-auto mb-10">
      <div class="flex flex-wrap gap-2 mb-5">
        <PostTags post={post} />
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold leading-[1.1] tracking-tight text-on-background font-headline mb-5">
        {post.Icon && post.Icon.Type === 'emoji' && 'Emoji' in post.Icon && (
          <span class="inline-block mr-2 text-[0.85em]">{post.Icon.Emoji}</span>
        )}
        {post.Title}
      </h1>
      {post.Excerpt && (
        <p class="text-lg md:text-xl text-on-surface-variant font-light leading-relaxed mb-6">
          {post.Excerpt}
        </p>
      )}
      <div class="flex items-center gap-3 text-sm text-on-surface-variant border-t border-outline-variant/20 pt-5">
        {post.Date && (
          <time datetime={post.Date} class="font-medium">{formatDateShort(post.Date)}</time>
        )}
        {readTime && <span aria-hidden="true">·</span>}
        {readTime && <span>{readTime} {uiStrings.app.post.readingTimeSuffix}</span>}
      </div>
    </article>

    <!-- Hero Image - Full bleed on mobile, constrained on desktop -->
    {post.FeaturedImage?.Url && (
      <div class="relative w-full md:max-w-7xl md:mx-auto h-[300px] sm:h-[400px] md:h-[614px] md:rounded-[2rem] overflow-hidden mb-12 md:mb-20 shadow-ambient">
        <PostFeaturedImage post={post} loading="eager" />
      </div>
    )}

    <!-- Body Content: gate for unauthenticated, full article for signed-in users -->
    <article class="px-0">
      {isSignedIn ? (
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
          <!-- Social Side Bar (desktop only) -->
          <aside class="md:col-span-1 hidden md:flex flex-col gap-8 sticky top-32 h-fit">
            <div class="w-px h-24 bg-primary-fixed mx-auto"></div>
            <a
              href="#"
              class="share-sidebar-twitter text-on-surface-variant hover:text-primary transition-colors flex justify-center"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={uiStrings.app.post.shareTwitterAriaLabel}
              data-path={getPostLink(post.Slug)}
              data-title={post.Title}
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path>
              </svg>
            </a>
            <a
              href="#"
              class="share-sidebar-facebook text-on-surface-variant hover:text-primary transition-colors flex justify-center"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={uiStrings.app.post.shareFacebookAriaLabel}
              data-path={getPostLink(post.Slug)}
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
            <a
              href="#"
              class="share-sidebar-whatsapp text-on-surface-variant hover:text-primary transition-colors flex justify-center"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={uiStrings.app.post.shareWhatsAppAriaLabel}
              data-path={getPostLink(post.Slug)}
              data-title={post.Title}
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path>
                <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"></path>
              </svg>
            </a>
            <button
              class="share-sidebar-copy text-on-surface-variant hover:text-primary transition-colors flex justify-center bg-transparent border-0 cursor-pointer p-0"
              aria-label={uiStrings.app.post.shareCopyLinkAriaLabel}
              data-path={getPostLink(post.Slug)}
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
            </button>
          </aside>

          <!-- Article Text -->
          <div class="md:col-span-7 md:col-start-3">
            {blocks.length > 0 ? (
              <PostBody blocks={blocks} />
            ) : (
              <NoContents contents={[]} />
            )}
          </div>

          <!-- Right Rail Ad (desktop only) -->
          <div class="hidden lg:flex md:col-span-2 flex-col sticky top-32 h-fit pt-2">
            <AdUnit label="Sidebar — 300×250" format="rectangle" />
          </div>
        </div>
      ) : (
        <ContentGate previewBlocks={previewBlocks} />
      )}
    </article>

    <!-- Article end marker for scroll tracking (signed-in only) -->
    {isSignedIn && <div id="article-content-end" style="height: 1px;"></div>}

    <!-- Tags + separator -->
    <div class="max-w-3xl mx-auto mt-10 pt-8 border-t border-outline-variant/25">
      <PostTags post={post} />
    </div>

    <!-- End-of-article ad -->
    <div class="max-w-3xl mx-auto my-8">
      <AdUnit label="In-Article Ad — 728×90" format="horizontal" />
    </div>

    <!-- Read Next Section -->
    <RelatedArticles
      posts={relatedPosts.length > 0 ? relatedPosts : rankedPosts}
      currentPostSlug={post.Slug}
      title={uiStrings.app.post.relatedHeading}
    />

    <!-- Latest Posts Section -->
    <LatestPosts posts={latestForSection} title={uiStrings.app.post.latestHeading} />
  </div>
</Layout>

<script>
  document.querySelectorAll('.share-sidebar-twitter').forEach((el) => {
    const path = el.getAttribute('data-path') || ''
    const title = el.getAttribute('data-title') || ''
    const fullUrl = window.location.origin + path
    el.setAttribute('href', `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(fullUrl)}`)
  })
  document.querySelectorAll('.share-sidebar-facebook').forEach((el) => {
    const path = el.getAttribute('data-path') || ''
    const fullUrl = window.location.origin + path
    el.setAttribute('href', `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(fullUrl)}`)
  })
  document.querySelectorAll('.share-sidebar-whatsapp').forEach((el) => {
    const path = el.getAttribute('data-path') || ''
    const title = el.getAttribute('data-title') || ''
    const fullUrl = window.location.origin + path
    el.setAttribute('href', `https://wa.me/?text=${encodeURIComponent(title)}%20${encodeURIComponent(fullUrl)}`)
  })
  document.querySelectorAll('.share-sidebar-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const path = btn.getAttribute('data-path') || ''
      const fullUrl = window.location.origin + path
      try {
        await navigator.clipboard.writeText(fullUrl)
        ;(btn as HTMLElement).style.color = '#006577'
        setTimeout(() => { (btn as HTMLElement).style.color = '' }, 2000)
      } catch (err) {
        console.error('Failed to copy:', err)
      }
    })
  })

  // Reading progress bar — fills as the reader scrolls from the article start to its end marker
  const progressBar = document.getElementById('reading-progress')
  const startEl = document.getElementById('article-start')
  const endEl = document.getElementById('article-content-end')
  if (progressBar && startEl && endEl) {
    let ticking = false
    const updateProgress = () => {
      const startY = startEl.getBoundingClientRect().top + window.scrollY
      const endY = endEl.getBoundingClientRect().top + window.scrollY
      const total = endY - startY
      const scrolled = window.scrollY - startY
      const pct = total > 0 ? Math.min(100, Math.max(0, (scrolled / total) * 100)) : 0
      progressBar.style.width = `${pct}%`
      ticking = false
    }
    updateProgress()
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateProgress)
        ticking = true
      }
    }, { passive: true })
    window.addEventListener('resize', updateProgress)
  }
</script>
