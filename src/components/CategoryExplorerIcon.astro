---
/**
 * Custom line icons for home category cards — 48×48 viewBox, stroke currentColor.
 */
import type { CategoryExplorerIconKind } from '../lib/home-category-icons.ts'

export interface Props {
  kind: CategoryExplorerIconKind
}

const { kind } = Astro.props
---

<span class="category-explorer-icon inline-flex items-center justify-center" aria-hidden="true">
  <svg
    width="44"
    height="44"
    viewBox="0 0 48 48"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="category-explorer-icon-svg"
  >
    {
      kind === 'science' && (
        <>
          <circle cx="24" cy="24" r="3" class="cei-fill" />
          <ellipse
            cx="24"
            cy="24"
            rx="14"
            ry="6"
            transform="rotate(0 24 24)"
            class="cei-stroke"
            stroke-width="1.75"
            stroke-linecap="round"
          />
          <ellipse
            cx="24"
            cy="24"
            rx="14"
            ry="6"
            transform="rotate(60 24 24)"
            class="cei-stroke"
            stroke-width="1.75"
            stroke-linecap="round"
          />
          <ellipse
            cx="24"
            cy="24"
            rx="14"
            ry="6"
            transform="rotate(-60 24 24)"
            class="cei-stroke"
            stroke-width="1.75"
            stroke-linecap="round"
          />
        </>
      )
    }
    {
      kind === 'tech' && (
        <>
          <rect
            x="12"
            y="14"
            width="24"
            height="20"
            rx="3"
            class="cei-stroke"
            stroke-width="1.75"
          />
          <path
            d="M18 18h4M26 18h6M18 24h10M18 30h6M28 30h4"
            class="cei-stroke"
            stroke-width="1.5"
            stroke-linecap="round"
          />
          <path
            d="M15 34h18"
            class="cei-stroke-muted"
            stroke-width="1.5"
            stroke-linecap="round"
          />
          <circle cx="24" cy="10" r="2" class="cei-fill-soft" />
          <path d="M24 12v4" class="cei-stroke-muted" stroke-width="1.5" stroke-linecap="round" />
        </>
      )
    }
    {
      kind === 'nature' && (
        <>
          <path
            d="M24 38V22"
            class="cei-stroke"
            stroke-width="1.75"
            stroke-linecap="round"
          />
          <path
            d="M24 28c-6-4-8-12-4-16 3 5 2 12 4 16M24 26c6-5 9-14 5-18-2 6-1 13-5 18M24 30c-4-1-7-6-6-11 3 4 4 8 6 11"
            class="cei-stroke"
            stroke-width="1.65"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M14 40h20"
            class="cei-stroke-muted"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </>
      )
    }
    {
      kind === 'news' && (
        <>
          <path
            d="M14 12h16a2 2 0 012 2v22H16a2 2 0 00-2-2V12z"
            class="cei-stroke"
            stroke-width="1.75"
            stroke-linejoin="round"
          />
          <path d="M18 18h10M18 24h10M18 30h6" class="cei-stroke-muted" stroke-width="1.5" stroke-linecap="round" />
          <path
            d="M30 12v6l3 3 3-3v-6"
            class="cei-stroke"
            stroke-width="1.65"
            stroke-linejoin="round"
          />
        </>
      )
    }
    {
      kind === 'health' && (
        <>
          <path
            d="M24 36.5c-6.8-5.2-11-9.8-11-15.2a5.2 5.2 0 0110.4-.6A5.2 5.2 0 0135 21.3c0 5.4-4.2 10-11 15.2z"
            class="cei-stroke"
            stroke-width="1.75"
            stroke-linejoin="round"
          />
          <path
            d="M11 30.5h3.5l2-5 2.5 9 2.5-14 3 12 2-2h10.5"
            class="cei-stroke-muted"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </>
      )
    }
    {
      kind === 'stories' && (
        <>
          <path
            d="M14 10h8a4 4 0 014 4v24a3 3 0 00-3-3h-9V10z"
            class="cei-stroke"
            stroke-width="1.75"
            stroke-linejoin="round"
          />
          <path
            d="M34 10h-8a4 4 0 00-4 4v24a3 3 0 013-3h9V10z"
            class="cei-stroke-muted"
            stroke-width="1.75"
            stroke-linejoin="round"
          />
          <path d="M20 18h4M20 24h4M28 18h4M28 24h4" class="cei-stroke" stroke-width="1.35" stroke-linecap="round" />
        </>
      )
    }
    {
      kind === 'innovation' && (
        <>
          <path
            d="M24 8l2 6 6 1-4 5 1 6-5-3-5 3 1-6-4-5 6-1 2-6z"
            class="cei-stroke"
            stroke-width="1.65"
            stroke-linejoin="round"
          />
          <circle cx="24" cy="17" r="2.5" class="cei-fill" />
          <path
            d="M24 22v16M18 34h12"
            class="cei-stroke-muted"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </>
      )
    }
    {
      kind === 'space' && (
        <>
          <ellipse cx="24" cy="26" rx="12" ry="8" class="cei-stroke" stroke-width="1.75" />
          <ellipse
            cx="24"
            cy="26"
            rx="18"
            ry="5"
            transform="rotate(-20 24 26)"
            class="cei-stroke-muted"
            stroke-width="1.5"
          />
          <circle cx="24" cy="26" r="5" class="cei-fill-soft" />
          <path d="M34 12l1 3 3 1-3 1-1 3-1-3-3-1 3-1 1-3z" class="cei-fill" />
          <path d="M12 14h2M15 17v2" class="cei-stroke" stroke-width="1.35" stroke-linecap="round" />
        </>
      )
    }
    {
      kind === 'planet' && (
        <>
          <circle cx="24" cy="24" r="14" class="cei-stroke" stroke-width="1.75" />
          <path
            d="M10 24c4-3 10-5 16-3s10 5 12 10"
            class="cei-stroke-muted"
            stroke-width="1.5"
            stroke-linecap="round"
          />
          <path
            d="M12 30c5-2 12-1 18 2"
            class="cei-stroke-muted"
            stroke-width="1.35"
            stroke-linecap="round"
          />
          <circle cx="30" cy="18" r="2" class="cei-fill" />
        </>
      )
    }
    {
      kind === 'generic' && (
        <>
          <rect x="14" y="14" width="9" height="9" rx="2" class="cei-stroke" stroke-width="1.65" />
          <rect x="25" y="14" width="9" height="9" rx="2" class="cei-stroke-muted" stroke-width="1.65" />
          <rect x="14" y="25" width="9" height="9" rx="2" class="cei-stroke-muted" stroke-width="1.65" />
          <rect x="25" y="25" width="9" height="9" rx="2" class="cei-stroke" stroke-width="1.65" />
        </>
      )
    }
  </svg>
</span>

<style>
  .category-explorer-icon-svg {
    display: block;
  }
  /* Stroke-only shapes — avoid black fills from implicit SVG defaults */
  .category-explorer-icon-svg :where(path, ellipse, rect, circle) {
    fill: none;
  }
  .category-explorer-icon-svg .cei-fill,
  .category-explorer-icon-svg .cei-fill-soft {
    fill: currentColor;
  }
  .cei-stroke {
    stroke: currentColor;
  }
  .cei-stroke-muted {
    stroke: currentColor;
    opacity: 0.45;
  }
  .cei-fill {
    fill: currentColor;
  }
  .cei-fill-soft {
    fill: currentColor;
    opacity: 0.2;
  }
</style>
