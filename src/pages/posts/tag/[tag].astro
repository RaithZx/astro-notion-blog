---
export const prerender = true

import type { SelectProperty } from '../../../lib/interfaces.ts'
import {
  getPostsByTag,
  getAllTags,
  getPostCountByTag,
} from '../../../lib/notion/client.ts'
import { slugifyTag } from '../../../lib/blog-helpers.ts'
import Layout from '../../../layouts/Layout.astro'
import CategoryTagMain from '../../../components/CategoryTagMain.astro'
import uiStrings from '../../../locales/ui-strings.json'

export async function getStaticPaths() {
  const allTags = await getAllTags()
  return allTags.map((t: SelectProperty) => ({
    params: { tag: slugifyTag(t.name) },
    props: { tagName: t.name },
  }))
}

const { tag } = Astro.params
const { tagName } = Astro.props

const [posts, tags, totalInTag] = await Promise.all([
  getPostsByTag(tagName, 9999),
  getAllTags(),
  getPostCountByTag(tagName),
])

const brand = uiStrings.app.layout.brandName
const cp = uiStrings.app.categoryPage
---

<Layout
  title={cp.titleTemplate.replace('{{tag}}', tagName).replace('{{brand}}', brand)}
  description={cp.descriptionTemplate.replace('{{tag}}', tagName)}
  path={`/posts/tag/${tag}`}
  ogImage=""
  fullWidth={true}
  showCategoryNav={false}
>
  <div slot="main" class="w-full min-w-0">
    <CategoryTagMain
      tag={tagName}
      posts={posts}
      currentPage={1}
      numberOfPages={1}
      totalInTag={totalInTag}
      allTags={tags}
      useLoadMore={true}
    />
  </div>
</Layout>
