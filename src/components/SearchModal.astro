---
import uiStrings from '../locales/ui-strings.json'
const s = uiStrings.app.search
---

<div class="search-modal-container">
  <div class="overlay"></div>

  <div class="search-modal">
    <div class="search-prompt">
      <div class="search-input-row">
        <svg class="search-icon" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input type="text" placeholder={s.placeholder} aria-label={s.ariaLabel} autocomplete="off" spellcheck="false" />
        <kbd class="esc-hint">Esc</kbd>
      </div>
      <div class="search-hints">
        <span class="hint-item"><kbd>↑↓</kbd> {s.hintNavigate}</span>
        <span class="hint-item"><kbd>↵</kbd> {s.hintOpen}</span>
        <span class="hint-item"><kbd>⌘K</kbd> Abri</span>
      </div>
    </div>

    <div class="search-result">
      <div class="search-loading" style="display: none;">
        <div class="loading-spinner"></div>
        <span>{s.loading}</span>
      </div>

      <div class="search-idle" style="display: none;">
        <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" style="opacity:0.3;">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <p class="idle-title">{s.idleTitle}</p>
        <p class="idle-sub">{s.idleSub}</p>
      </div>

      <div class="search-empty" style="display: none;">
        <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" style="opacity:0.3;">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <p class="idle-title">{s.empty}</p>
        <p class="idle-sub" id="search-empty-query"></p>
      </div>

      <div class="search-results-header" style="display: none;">
        <span id="search-result-count"></span>
      </div>

      <ul></ul>
    </div>
  </div>
</div>

<style>
  div.search-modal-container {
    display: none;
  }

  div.overlay {
    z-index: 99;
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }

  div.search-modal {
    z-index: 100;
    position: fixed;
    top: 12%;
    left: 50%;
    transform: translateX(-50%);
    width: 92%;
    max-width: 620px;
    max-height: 76vh;
    border-radius: 16px;
    background-color: #ffffff;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(0,0,0,0.06);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 640px) {
    div.search-modal {
      top: 5%;
      width: 96%;
      max-height: 88vh;
      border-radius: 12px;
    }
  }

  /* --- Input row --- */
  div.search-prompt {
    padding: 0.875rem 1rem 0;
    border-bottom: 1px solid #f1f5f9;
  }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0 0.25rem 0.75rem;
  }

  .search-icon {
    color: #94a3b8;
    flex-shrink: 0;
  }

  div.search-prompt input {
    flex: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: #0f172a;
    font-size: 1.05rem;
    line-height: 1.5;
    outline: none;
  }

  div.search-prompt input::placeholder {
    color: #94a3b8;
  }

  .esc-hint {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.45rem;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 0.3rem;
    font-size: 0.6875rem;
    font-family: monospace;
    color: #64748b;
    cursor: pointer;
    flex-shrink: 0;
  }

  .search-hints {
    display: flex;
    gap: 1rem;
    padding-bottom: 0.625rem;
    flex-wrap: wrap;
  }

  .hint-item {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    color: #94a3b8;
  }

  .hint-item kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 1.25rem;
    padding: 0 0.3rem;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 0.25rem;
    font-size: 0.6875rem;
    font-family: monospace;
    color: #475569;
  }

  /* --- Results area --- */
  div.search-result {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .search-results-header {
    padding: 0.625rem 1rem 0.25rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  div.search-result ul {
    list-style: none;
    margin: 0;
    padding: 0.375rem 0.5rem 0.5rem;
  }

  /* --- Idle / empty states --- */
  .search-idle,
  .search-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 2.5rem 1.5rem;
    text-align: center;
  }

  .search-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem;
    color: #64748b;
    font-size: 0.875rem;
  }

  .search-loading .loading-spinner {
    width: 1.75rem;
    height: 1.75rem;
    border: 2px solid #e2e8f0;
    border-top-color: #3b82f6;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  .idle-title {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: #475569;
  }

  .idle-sub {
    margin: 0;
    font-size: 0.8rem;
    color: #94a3b8;
  }

  /* --- Result list items --- */
  div.search-result ul > :global(li > a) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.6rem 0.75rem;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.12s;
  }

  div.search-result ul > :global(li.selected > a),
  div.search-result ul > :global(li > a:hover) {
    background-color: #eff6ff;
  }

  div.search-result ul > :global(li.selected > a) {
    outline: 2px solid #bfdbfe;
  }

  div.search-result :global(.result-title) {
    font-size: 0.95rem;
    font-weight: 600;
    color: #0f172a;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  div.search-result :global(.result-excerpt) {
    font-size: 0.8rem;
    color: #64748b;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  div.search-result :global(.result-meta) {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex-wrap: wrap;
    margin-top: 0.125rem;
  }

  div.search-result :global(.result-tag) {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 500;
    padding: 0.15rem 0.5rem;
    border-radius: 99px;
    background: #f1f5f9;
    color: #475569;
  }

  div.search-result :global(.result-date) {
    font-size: 0.68rem;
    color: #94a3b8;
    margin-left: auto;
  }

  div.search-result :global(mark) {
    background: #fef08a;
    color: inherit;
    border-radius: 2px;
    padding: 0 1px;
  }
</style>

<script define:vars={{ searchLoadError: s.loadError }}>
  document.addEventListener('DOMContentLoaded', async () => {
    let feedItems = []
    let fetched = false
    let debounceTimer = null
    const DEBOUNCE = 250

    const container = document.querySelector('.search-modal-container')
    const input = document.querySelector('.search-prompt input')
    const overlay = document.querySelector('.overlay')
    const ul = document.querySelector('.search-result ul')
    const loadingEl = document.querySelector('.search-loading')
    const idleEl = document.querySelector('.search-idle')
    const emptyEl = document.querySelector('.search-empty')
    const emptyQuery = document.getElementById('search-empty-query')
    const resultsHeader = document.querySelector('.search-results-header')
    const resultCount = document.getElementById('search-result-count')
    const escHint = document.querySelector('.esc-hint')

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
    }

    function highlight(text, query) {
      if (!query || !text) return escapeHtml(text || '')
      const safe = escapeHtml(text)
      const escapedQ = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
      return safe.replace(new RegExp(escapedQ, 'gi'), '<mark>$&</mark>')
    }

    function formatDate(dateStr) {
      if (!dateStr) return ''
      try {
        return new Intl.DateTimeFormat('pt', { month: 'short', year: 'numeric' }).format(new Date(dateStr))
      } catch { return '' }
    }

    function setState(state) {
      loadingEl.style.display = state === 'loading' ? 'flex' : 'none'
      idleEl.style.display = state === 'idle' ? 'flex' : 'none'
      emptyEl.style.display = state === 'empty' ? 'flex' : 'none'
      resultsHeader.style.display = state === 'results' ? 'block' : 'none'
      ul.style.display = state === 'results' ? 'block' : 'none'
    }

    async function openModal() {
      container.style.display = 'block'
      input.focus()
      input.select()

      if (!fetched) {
        setState('loading')
        try {
          await fetchSearchIndex()
        } catch {
          setState('empty')
          if (emptyQuery) emptyQuery.textContent = searchLoadError
          return
        }
      }

      searchAndRender()
    }

    function closeModal() {
      container.style.display = 'none'
      if (debounceTimer) clearTimeout(debounceTimer)
    }

    function search(query) {
      const q = query.toLowerCase()
      const scored = []
      feedItems.forEach((item) => {
        const titleLower = (item.title || '').toLowerCase()
        const descLower = (item.description || '').toLowerCase()
        let score = 0
        if (titleLower.startsWith(q)) score = 3
        else if (titleLower.includes(q)) score = 2
        else if (descLower.includes(q)) score = 1
        if (score > 0) scored.push({ item, score })
      })
      scored.sort((a, b) => b.score - a.score)
      return scored.map((s) => s.item)
    }

    function renderResults(results, query) {
      ul.innerHTML = ''

      if (!query) {
        setState('idle')
        return
      }

      if (results.length === 0) {
        setState('empty')
        if (emptyQuery) emptyQuery.textContent = `"${query}"`
        return
      }

      setState('results')
      if (resultCount) {
        resultCount.textContent = `${results.length} rezultadu${results.length !== 1 ? 's' : ''}`
      }

      results.forEach((item) => {
        const li = document.createElement('li')
        const a = document.createElement('a')
        a.href = item.link

        const title = document.createElement('div')
        title.className = 'result-title'
        title.innerHTML = highlight(item.title, query)

        a.appendChild(title)

        if (item.description) {
          const excerpt = document.createElement('div')
          excerpt.className = 'result-excerpt'
          excerpt.innerHTML = highlight(item.description, query)
          a.appendChild(excerpt)
        }

        const meta = document.createElement('div')
        meta.className = 'result-meta'

        if (item.tags && item.tags.length > 0) {
          item.tags.slice(0, 3).forEach((tag) => {
            const chip = document.createElement('span')
            chip.className = 'result-tag'
            chip.textContent = tag
            meta.appendChild(chip)
          })
        }

        const date = formatDate(item.pubDate)
        if (date) {
          const dateEl = document.createElement('span')
          dateEl.className = 'result-date'
          dateEl.textContent = date
          meta.appendChild(dateEl)
        }

        if (meta.children.length > 0) a.appendChild(meta)

        li.addEventListener('mouseover', handleMouseover)
        li.appendChild(a)
        ul.appendChild(li)
      })

      selectFirst()
    }

    function searchAndRender() {
      const query = input.value.trim()
      if (!query) {
        renderResults([], '')
        return
      }
      const results = search(query)
      renderResults(results, query)
    }

    function selectFirst() {
      const first = ul.querySelector('li:first-child')
      if (first) first.classList.add('selected')
    }

    function handleMouseover(e) {
      const li = e.target.closest('li')
      if (!li) return
      ul.querySelectorAll('li').forEach((el) => el.classList.remove('selected'))
      li.classList.add('selected')
    }

    function handleKeydown(e) {
      if (!container || container.style.display === 'none') {
        // Cmd+K / Ctrl+K to open
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault()
          openModal()
        }
        return
      }

      if (e.key === 'Enter') {
        if (debounceTimer) clearTimeout(debounceTimer)
        const selected = ul.querySelector('li.selected a')
        if (selected) selected.click()
      } else if (e.key === 'Escape') {
        closeModal()
      } else if (e.key === 'ArrowUp') {
        e.preventDefault()
        moveSelection(-1)
      } else if (e.key === 'ArrowDown') {
        e.preventDefault()
        moveSelection(1)
      }
    }

    function moveSelection(dir) {
      const items = Array.from(ul.querySelectorAll('li'))
      if (!items.length) return
      const currentIdx = items.findIndex((li) => li.classList.contains('selected'))
      items.forEach((li) => li.classList.remove('selected'))
      let next = currentIdx + dir
      if (next < 0) next = items.length - 1
      if (next >= items.length) next = 0
      items[next]?.classList.add('selected')
      items[next]?.scrollIntoView({ block: 'nearest' })
    }

    async function fetchSearchIndex() {
      const url = new URL(location.href)
      const port = url.port ? `:${url.port}` : ''
      const res = await fetch(`${url.protocol}//${url.hostname}${port}/search-index.json`)
      if (!res.ok) throw new Error('fetch failed')
      const items = await res.json()
      feedItems = items.map((item) => ({
        title: item.title,
        link: window.location.origin + item.link,
        description: item.excerpt ?? item.description ?? '',
        pubDate: item.pubDate,
        tags: item.tags ?? [],
      }))
      fetched = true
    }

    // Wire up open buttons
    document.querySelectorAll('.open-search-modal').forEach((el) => {
      el.addEventListener('click', openModal)
    })

    overlay.addEventListener('click', closeModal)
    if (escHint) escHint.addEventListener('click', closeModal)

    input.addEventListener('input', () => {
      if (debounceTimer) clearTimeout(debounceTimer)
      debounceTimer = setTimeout(searchAndRender, DEBOUNCE)
    })

    document.addEventListener('keydown', handleKeydown)

    // Show idle state immediately when fetched and input is empty
    setState('idle')
  })
</script>
