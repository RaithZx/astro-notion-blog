---
import { getPageLink } from '../lib/blog-helpers.ts'
import uiStrings from '../locales/ui-strings.json'
const p = uiStrings.app.pagination

export interface Props {
  currentPage: number
  numberOfPages: number
  tag: string
}

const { currentPage, numberOfPages, tag = '' } = Astro.props

const isFirstPage = currentPage === 1
const isLastPage = currentPage === numberOfPages

const startPage = currentPage - 2 < 1 ? 1 : currentPage - 2
const endPage =
  currentPage + 2 > numberOfPages ? numberOfPages : currentPage + 2

let pages = []
for (let i = startPage; i <= endPage; i++) {
  pages.push(i)
}

const focusRing = 'focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2'
const btnBase = `flex items-center gap-2 px-4 py-2.5 min-h-[2.75rem] rounded-xl bg-surface-container-lowest text-on-surface text-sm font-medium no-underline transition-all hover:bg-surface-container-low ${focusRing}`
const numberBase = `flex items-center justify-center min-w-[2.75rem] h-11 px-3 rounded-xl bg-surface-container-lowest text-on-surface text-sm font-medium no-underline transition-all hover:bg-surface-container-low ${focusRing}`
---

<nav class="flex flex-col gap-4 w-full my-8 py-6" aria-label="Pagination Navigation">
  <div class="text-center">
    <span class="text-on-surface-variant text-sm font-medium">
      {p.pageOf.replace('{{current}}', String(currentPage)).replace('{{total}}', String(numberOfPages))}
    </span>
  </div>

  <div class="flex justify-center items-center gap-2 flex-wrap">
    <a
      href={getPageLink(Math.max(1, currentPage - 1), tag)}
      class:list={[btnBase, isFirstPage && 'opacity-50 pointer-events-none']}
      aria-label={p.previousAriaLabel}
      aria-disabled={isFirstPage}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
      <span class="hidden sm:inline">{p.previous}</span>
    </a>

    <div class="flex items-center gap-1">
      {!isFirstPage && startPage > 1 && (
        <>
          <a href={getPageLink(1, tag)} class={numberBase}>1</a>
          {startPage > 2 && <span class="flex items-center justify-center min-w-[2.75rem] h-11 text-on-surface-variant/80 text-sm">...</span>}
        </>
      )}
      {
        pages.map((p: number) => (
          <a
            href={getPageLink(p, tag)}
            class:list={[
              numberBase,
              p === currentPage && 'bg-primary text-on-primary font-semibold hover:brightness-105',
            ]}
            aria-label={uiStrings.app.pagination.pageAriaLabel.replace('{{page}}', String(p))}
            aria-current={p === currentPage ? 'page' : undefined}
          >
            {p}
          </a>
        ))
      }
      {!isLastPage && endPage < numberOfPages && (
        <>
          {endPage < numberOfPages - 1 && <span class="flex items-center justify-center min-w-[2.75rem] h-11 text-on-surface-variant/80 text-sm">...</span>}
          <a href={getPageLink(numberOfPages, tag)} class={numberBase}>{numberOfPages}</a>
        </>
      )}
    </div>

    <a
      href={getPageLink(Math.min(numberOfPages, currentPage + 1), tag)}
      class:list={[btnBase, isLastPage && 'opacity-50 pointer-events-none']}
      aria-label={p.nextAriaLabel}
      aria-disabled={isLastPage}
    >
      <span class="hidden sm:inline">{p.next}</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </a>
  </div>
</nav>
