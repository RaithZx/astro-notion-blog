---
export const prerender = true

import Layout from '../layouts/Layout.astro'
import { getNavLink, getPostLink } from '../lib/blog-helpers.ts'
import { getPosts } from '../lib/notion/client.ts'
import uiStrings from '../locales/ui-strings.json'

const s = uiStrings.app.notFound
const recentPosts = await getPosts(4)
---

<Layout
  title={s.pageTitle}
  description={s.body}
  path="/404"
  ogImage=""
>
  <div slot="main">
    <div class="relative flex flex-col items-center justify-center min-h-[72vh] text-center px-6 py-16 overflow-hidden">

      <!-- Dot-grid field -->
      <div
        aria-hidden="true"
        class="absolute inset-0 pointer-events-none select-none"
        style="
          background-image: radial-gradient(circle, rgba(0,88,190,0.07) 1px, transparent 1px);
          background-size: 28px 28px;
          mask-image: radial-gradient(ellipse 90% 70% at 50% 40%, black 0%, transparent 72%);
          -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 40%, black 0%, transparent 72%);
        "
      ></div>

      <!-- Orbit rings -->
      <div
        aria-hidden="true"
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[520px] h-[520px] pointer-events-none select-none"
      >
        <div class="absolute inset-0 rounded-full border border-primary/[0.07]"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] h-[350px] rounded-full border border-primary/[0.10]"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[200px] h-[200px] rounded-full border border-primary/[0.15]"></div>
      </div>

      <!-- Illustration: broken satellite dish -->
      <div class="relative z-10 mb-4 w-full max-w-[260px] mx-auto" aria-hidden="true">
        <svg viewBox="0 0 260 200" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="18"  cy="22"  r="1.5" fill="#0058be" opacity="0.35"/>
          <circle cx="240" cy="18"  r="1.2" fill="#0058be" opacity="0.3"/>
          <circle cx="210" cy="55"  r="1.8" fill="#0058be" opacity="0.25"/>
          <circle cx="42"  cy="70"  r="1"   fill="#0058be" opacity="0.2"/>
          <circle cx="248" cy="80"  r="1.5" fill="#0058be" opacity="0.2"/>
          <circle cx="28"  cy="110" r="1"   fill="#0058be" opacity="0.15"/>
          <ellipse cx="118" cy="190" rx="58" ry="6" fill="#0058be" opacity="0.07"/>
          <rect x="96" y="179" width="44" height="9" rx="4.5" fill="#545f73" opacity="0.45"/>
          <rect x="114" y="138" width="7" height="43" rx="3" fill="#545f73" opacity="0.55"/>
          <circle cx="117.5" cy="138" r="5" fill="#545f73" opacity="0.45"/>
          <line x1="117" y1="133" x2="136" y2="100" stroke="#545f73" stroke-width="3.5" stroke-linecap="round" opacity="0.6"/>
          <circle cx="137" cy="98" r="5.5" fill="#0058be" opacity="0.75"/>
          <circle cx="137" cy="98" r="2.5" fill="#ffffff" opacity="0.6"/>
          <path d="M78 138 Q117 98 157 138" stroke="#0058be" stroke-width="3.5" stroke-linecap="round" fill="none"/>
          <path d="M78 138 Q117 98 157 138 Q137 165 117.5 160 Q98 165 78 138 Z" fill="#0058be" opacity="0.08"/>
          <path d="M78 138 Q117 98 157 138" stroke="#0058be" stroke-width="1" stroke-linecap="round" fill="none" opacity="0.25" stroke-dasharray="4 6"/>
          <path d="M147 84 Q158 70 170 76" stroke="#0058be" stroke-width="2.5" stroke-linecap="round" fill="none" opacity="0.9"/>
          <path d="M158 68 Q175 48 190 56" stroke="#0058be" stroke-width="2" stroke-linecap="round" stroke-dasharray="5 5" fill="none" opacity="0.55"/>
          <path d="M168 52 Q192 26 210 36" stroke="#0058be" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="3 7" fill="none" opacity="0.25"/>
          <circle cx="222" cy="28" r="3.5" fill="#0058be" opacity="0.18"/>
          <circle cx="235" cy="16" r="2"   fill="#0058be" opacity="0.12"/>
          <circle cx="214" cy="22" r="11" stroke="#0058be" stroke-width="1.5" opacity="0.3" fill="#0058be" fill-opacity="0.07"/>
          <path d="M208 16 L220 28" stroke="#0058be" stroke-width="2" stroke-linecap="round" opacity="0.55"/>
          <path d="M220 16 L208 28" stroke="#0058be" stroke-width="2" stroke-linecap="round" opacity="0.55"/>
          <circle cx="162" cy="152" r="2.5" fill="#545f73" opacity="0.3"/>
          <circle cx="72"  cy="128" r="2"   fill="#545f73" opacity="0.2"/>
        </svg>
      </div>

      <!-- Semantic heading -->
      <h1 class="relative z-10 text-2xl sm:text-3xl font-bold font-headline text-on-surface mb-10">
        {s.subheading}
      </h1>

      <!-- Recent posts -->
      {recentPosts.length > 0 && (
        <div class="relative z-10 w-full max-w-lg mb-8">
          <p class="text-xs font-semibold uppercase tracking-wider text-on-surface-variant mb-4">
            {uiStrings.app.home.latestHeading}
          </p>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 list-none p-0 m-0 text-left">
            {recentPosts.map((post) => (
              <li>
                <a
                  href={getPostLink(post.Slug)}
                  class="flex flex-col gap-1 rounded-xl bg-surface-container-lowest hover:bg-surface-container ring-1 ring-outline-variant/15 px-4 py-3 transition-colors no-underline group"
                >
                  {post.Tags?.[0] && (
                    <span class="text-tertiary font-bold text-[10px] uppercase tracking-widest">
                      {post.Tags[0].name}
                    </span>
                  )}
                  <span class="font-semibold text-sm font-headline text-on-surface leading-snug line-clamp-2 group-hover:text-primary transition-colors">
                    {post.Title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Home link -->
      <a
        href={getNavLink('/')}
        class="relative z-10 text-sm text-on-surface-variant underline underline-offset-4 hover:text-primary transition-colors"
      >
        {s.cta}
      </a>

    </div>
  </div>
</Layout>
