---
import '../styles/globals.css'
import { PUBLIC_GA_TRACKING_ID, ENABLE_LIGHTBOX, COMING_SOON } from '../server-constants.ts'
import { getDatabase } from '../lib/notion/client.ts'
import { getNavLink, getTagLink, getStaticFilePath, filePath } from '../lib/blog-helpers.ts'
import '../styles/syntax-coloring.css'
import GoogleAnalytics from '../components/GoogleAnalytics.astro'
import SearchModal from '../components/SearchModal.astro'
import ComingSoon from '../components/ComingSoon.astro'
import SocialIcons from '../components/SocialIcons.astro'
import BackToTop from '../components/BackToTop.astro'
import { UserButton } from '@clerk/astro/components'
import uiStrings from '../locales/ui-strings.json'

export interface Props {
  title: string
  description: string
  path: string
  ogImage: string
  fullWidth?: boolean
}

const app = uiStrings.app
const { title = app.site.defaultTitle, description = app.site.defaultDescription, path = '/', ogImage = '', fullWidth = false } = Astro.props

/** Topic links — Notion tag names must match database (see getAllTags). */
const navTopicScience = getTagLink('Siênsia')
const navTopicTech = getTagLink('Tekinolojia')
const navTopicInnovation = '#'
const navTopicSpace = '#'

function topicNavClass(_href: string, active: boolean): string {
  const base =
    'no-underline transition-colors duration-300 pb-1 border-b-2 border-transparent hover:text-tertiary'
  if (active) {
    return `${base} text-primary font-bold border-primary hover:text-tertiary`
  }
  return `${base} text-on-background/60 font-medium`
}

const pathNorm = path.split('?')[0] ?? path
const activeScience =
  pathNorm === navTopicScience || pathNorm.startsWith(`${navTopicScience}/`)
const activeTech = pathNorm === navTopicTech || pathNorm.startsWith(`${navTopicTech}/`)

// Check if we should show the coming soon page
const showComingSoon = COMING_SOON === 'true' || COMING_SOON === true

// Check if we're in production for analytics tracking
const isProduction = import.meta.env.PROD

const database = await getDatabase()

const siteTitle = title ? `${title}` : app.site.defaultTitle
const siteDescription = description ? description : database.Description
const siteURL = new URL(getNavLink(path), Astro.site).toString()
const siteOGImage = new URL(
  getStaticFilePath('/ligadu_logo.png'),
  Astro.site
)

// Newsletter API URL - defaults to relative path for production (Coolify proxy)
const newsletterApiUrl = import.meta.env.NEWSLETTER_API_URL || ''

let coverImageURL: string
if (database.Cover) {
  if (database.Cover.Type === 'external') {
    coverImageURL = database.Cover.Url
  } else if (database.Cover.Type === 'file') {
    try {
      coverImageURL = filePath(new URL(database.Cover.Url))
    } catch {
      console.log('Invalid DB cover image URL: ', database.Cover?.Url)
    }
  }
}

let customIconURL: string = ''
if (database.Icon && database.Icon.Type === 'file') {
  try {
    customIconURL = filePath(new URL((database.Icon as any).Url))
  } catch {
    console.log('Invalid DB custom icon URL: ', (database.Icon as any)?.Url)
  }
}
---

<!DOCTYPE html>
<html lang="kea" prefix="og: https://ogp.me/ns#">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="max-image-preview:large" />
    <meta charset="UTF-8" />
    <meta name="generator" content={Astro.generator} />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={siteURL} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/ligadu_logo.png" />
    <link rel="shortcut icon" href="/ligadu_logo.png" />
    <link rel="apple-touch-icon" href="/ligadu_logo.png" />
    <meta property="og:url" content={siteURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:site_name" content={database.Title} />
    <meta property="og:image" content={ogImage || siteOGImage} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage || siteOGImage} />
    <!-- Google Fonts: Inter for body/UI, Space Grotesk for headlines -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.4/dist/katex.min.css"
      integrity="sha384-vKruj+a13U8yHIkAyGgK1J3ArTLzrFGBbBc0tDp4ad/EyewESeXE/Iv67Aj8gKZ0"
      crossorigin="anonymous"
    />
	 <script 
      defer 
      src="https://stats.ligadu.com/script.js" 
      data-website-id="3a333f58-6b50-445d-9ccf-3cec581bc5e9"
      data-do-not-track={isProduction ? "false" : "true"}
    ></script>
  </head>
  <body>
    {showComingSoon ? (
      <ComingSoon />
    ) : (
      <>
    <GoogleAnalytics trackingId={PUBLIC_GA_TRACKING_ID} />
    
    <!-- Skip to content link for accessibility -->
    <a href="#main-content" class="skip-to-content">
      {app.layout.skipToContent}
    </a>
    
    <!-- Fixed glass nav: sticky breaks under some scroll parents; fixed + content offset is reliable -->
    <header
      id="main-header"
      class="fixed inset-x-0 top-0 z-[90] w-full border-0 isolate bg-surface/80 shadow-none supports-[backdrop-filter]:bg-surface/75 backdrop-blur-xl"
    >
      <nav class="flex justify-between items-center w-full px-8 py-4 max-w-7xl mx-auto">
        <div class="flex items-center gap-6 md:gap-12 min-w-0">
          <button
            id="mobile-menu-button"
            class="md:hidden bg-transparent border-0 text-on-surface-variant cursor-pointer p-2 hover:text-primary rounded transition-colors focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2 shrink-0"
            aria-label={app.layout.ariaOpenMobileMenu}
            aria-expanded="false"
            aria-controls="mobile-drawer"
            type="button"
          >
            <span class="material-symbols-outlined text-2xl leading-none" aria-hidden="true">menu</span>
          </button>

          <a
            href={getNavLink('/')}
            class="text-2xl font-black font-headline tracking-tight text-primary no-underline shrink-0"
          >
            {app.layout.brandName}
          </a>

          <div class="hidden md:flex items-center gap-8">
            <a href={navTopicScience} class={topicNavClass(navTopicScience, activeScience)}>
              {app.layout.navScience}
            </a>
            <a href={navTopicTech} class={topicNavClass(navTopicTech, activeTech)}>
              {app.layout.navTech}
            </a>
          </div>
        </div>

        <div class="flex items-center gap-4 md:gap-6 shrink-0">
          <button
            class="open-search-modal bg-transparent border-0 text-on-surface-variant hover:text-primary transition-colors p-1.5 rounded-full focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
            aria-label={app.layout.ariaOpenSearch}
            type="button"
          >
            <span class="material-symbols-outlined text-2xl leading-none" aria-hidden="true">search</span>
          </button>

          <div class="ligadu-auth-when-signed-out flex md:hidden items-center">
            <button
              type="button"
              class="ligadu-open-sign-up bg-primary-container text-on-primary-container px-4 py-2 rounded-full font-bold text-xs transition-transform duration-200 active:scale-95 border-0 cursor-pointer"
            >
              {app.layout.navSignUpCta}
            </button>
          </div>

          <div class="ligadu-auth-when-signed-out hidden md:flex items-center gap-4">
            <button
              type="button"
              class="ligadu-open-sign-in bg-transparent border-0 text-sm font-medium text-on-background/60 hover:text-tertiary transition-colors duration-300 cursor-pointer p-0"
            >
              {app.layout.authSignIn}
            </button>
            <button
              type="button"
              class="ligadu-open-sign-up bg-primary-container text-on-primary-container px-6 py-2.5 rounded-full font-bold text-sm transition-transform duration-200 active:scale-95 border-0 cursor-pointer"
            >
              {app.layout.navSignUpCta}
            </button>
          </div>

          <div class="ligadu-auth-when-signed-in flex items-center ligadu-auth-hide [&_.cl-userButtonBox]:shrink-0">
            <UserButton />
          </div>
        </div>
      </nav>
      
      <!-- Mobile Navigation Drawer -->
      <div id="mobile-overlay" class="md:hidden fixed inset-0 bg-black/50 opacity-0 transition-opacity duration-300 pointer-events-none" style="z-index: 9998;"></div>
      
      <div id="mobile-drawer" class="md:hidden fixed top-0 left-0 w-80 max-w-sm h-full bg-surface-container-lowest shadow-ambient-lg transform -translate-x-full transition-transform duration-300 ease-in-out pointer-events-none flex flex-col" style="z-index: 9999;">
        <div class="flex items-center justify-between p-5 bg-surface-container-low">
          <a href={getNavLink('/')} class="text-lg font-bold font-headline text-primary no-underline">{app.layout.brandName}</a>
          <button 
            id="mobile-close-button" 
            class="bg-transparent border-0 text-on-surface-variant text-2xl cursor-pointer p-2 hover:text-primary rounded-full transition-colors focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
            aria-label={app.layout.ariaCloseMobileMenu}
          >
            <span aria-hidden="true">✕</span>
          </button>
        </div>
        
        <div class="flex-1 p-5 overflow-y-auto">
          <nav class="space-y-1">
            <a href={getNavLink('/')} class="block text-on-surface no-underline py-3 px-4 font-medium rounded-lg hover:text-primary hover:bg-surface-container-low transition-colors">{app.layout.navHome}</a>
            <a href={navTopicScience} class="block text-on-surface no-underline py-3 px-4 font-medium rounded-lg hover:text-primary hover:bg-surface-container-low transition-colors">{app.layout.navScience}</a>
            <a href={navTopicTech} class="block text-on-surface no-underline py-3 px-4 font-medium rounded-lg hover:text-primary hover:bg-surface-container-low transition-colors">{app.layout.navTech}</a>
            <a href={getNavLink('/kontaktu')} class="block text-on-surface no-underline py-3 px-4 font-medium rounded-lg hover:text-primary hover:bg-surface-container-low transition-colors">{app.layout.navContact}</a>
          </nav>
          
          <div class="mt-6 pt-6 space-y-3 bg-surface-container-low -mx-5 px-5 py-6 rounded-xl">
            <button 
              class="open-search-modal w-full ds-btn-secondary px-4 py-3 text-sm cursor-pointer flex items-center justify-center gap-2"
              type="button"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
              <span>{app.layout.searchShort}</span>
            </button>
            <div class="ligadu-auth-when-signed-out space-y-3">
              <button
                type="button"
                class="ligadu-open-sign-in w-full ds-btn-primary px-4 py-3 text-sm"
              >
                {app.layout.authSignIn}
              </button>
              <button
                type="button"
                class="ligadu-open-sign-up w-full bg-primary-container text-on-primary-container px-4 py-3 text-sm font-bold rounded-full border-0 cursor-pointer transition-transform active:scale-95"
              >
                {app.layout.navSignUpCta}
              </button>
              <button
                type="button"
                class="newsletter-btn w-full ds-btn-secondary px-4 py-3 text-sm"
              >
                {app.layout.newsletterSubscribeShort}
              </button>
            </div>
            <div class="ligadu-auth-when-signed-in flex justify-center py-2 ligadu-auth-hide">
              <UserButton />
            </div>
          </div>
        </div>
      </div>
    </header>

    <div
      class="min-h-screen bg-surface layout-page-shell pt-[4.75rem] md:pt-[5rem]"
      style="overflow-x: hidden; max-width: 100vw; position: relative; z-index: 0;"
    >
      <slot name="featured" />
      {fullWidth ? (
        <main
          id="main-content"
          class="w-full max-w-7xl mx-auto px-4 md:px-8 pt-12"
          style="overflow-x: hidden; min-width: 0; position: relative; z-index: 1;"
          tabindex="-1"
        >
          <slot name="main" />
        </main>
      ) : (
        <div class="flex flex-col lg:flex-row gap-6 lg:gap-8 px-5 py-8 max-sm:px-2.5 max-sm:py-5" style="max-width: 1200px; margin: 0 auto; overflow-x: hidden; position: relative; z-index: 1;">
          <main id="main-content" class="flex-1 lg:flex-[3] p-0 max-sm:p-5" style="max-width: 100%; overflow-x: hidden; min-width: 0; position: relative; z-index: 1;" tabindex="-1">
            <div class="main-content-wrapper" style="max-width: 100%;">
              <slot name="main" />
            </div>
          </main>

          <aside class="w-full lg:w-auto lg:flex-1 lg:max-w-xs p-0 lg:p-8 h-fit max-sm:p-5 empty:hidden">
            <slot name="aside" />
          </aside>
        </div>
      )}
    </div>

    <SearchModal />
    
    <BackToTop />
    
    <!-- Footer -->
    <footer class="bg-surface-container-low w-full rounded-t-[2rem] mt-20">
      <div class="max-w-7xl mx-auto px-8 py-16 grid grid-cols-1 md:grid-cols-4 gap-12">
        <!-- Brand Section -->
        <div class="space-y-6">
          <a href={getNavLink('/')} class="text-xl font-bold font-headline text-primary no-underline">{app.layout.brandName}</a>
          <p class="text-on-background/70 text-sm leading-relaxed">
            {app.layout.footerBrandBlurb}
          </p>
          <SocialIcons />
        </div>
        
        <!-- Navigation -->
        <div>
          <h4 class="font-bold font-headline mb-6 text-primary">Navegason</h4>
          <ul class="space-y-4 text-sm">
            <li><a href={getNavLink('/')} class="text-on-background/70 no-underline hover:underline decoration-tertiary decoration-2 underline-offset-4 transition-colors">{app.layout.navHome}</a></li>
            <li><a href={getNavLink('/kontaktu')} class="text-on-background/70 no-underline hover:underline decoration-tertiary decoration-2 underline-offset-4 transition-colors">{app.layout.navContact}</a></li>
            <li><a href="/privasidadi" class="text-on-background/70 no-underline hover:underline decoration-tertiary decoration-2 underline-offset-4 transition-colors">{app.layout.footerPrivacy}</a></li>
            <li><a href="/termus" class="text-on-background/70 no-underline hover:underline decoration-tertiary decoration-2 underline-offset-4 transition-colors" set:html={app.layout.footerTermsInnerHtml}></a></li>
          </ul>
        </div>
        
        <!-- Topics -->
        <div>
          <h4 class="font-bold font-headline mb-6 text-primary">Topikus</h4>
          <ul class="space-y-4 text-sm">
            <li><a href={navTopicScience} class="text-on-background/70 no-underline hover:underline decoration-tertiary decoration-2 underline-offset-4 transition-colors">{app.layout.navScience}</a></li>
            <li><a href={navTopicTech} class="text-on-background/70 no-underline hover:underline decoration-tertiary decoration-2 underline-offset-4 transition-colors">{app.layout.navTech}</a></li>
          </ul>
        </div>
        
        <!-- Newsletter -->
        <div>
          <h4 class="font-bold font-headline mb-6 text-primary">{app.layout.footerNewsletterHeading}</h4>
          <div class="ligadu-auth-when-signed-out">
            <button 
              type="button"
              id="footer-newsletter-btn"
              class="newsletter-btn w-full ds-btn-primary py-3 text-sm"
            >
              {app.layout.footerNewsletterCta}
            </button>
          </div>
        </div>
      </div>
      
      <!-- Bottom Bar -->
      <div class="max-w-7xl mx-auto px-8 pb-8 text-center text-on-background/50 text-xs">
        © {new Date().getFullYear()} {database.Title} — Laboratòriu Digital di Kabu Verdi
      </div>
    </footer>
    
    <!-- Newsletter Signup Modal - Modern Redesign -->
    <div id="newsletter-modal" class="fixed inset-0 z-[110] hidden">
      <!-- Overlay with backdrop blur -->
      <div id="newsletter-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm"></div>
      
      <!-- Modal Content -->
      <div class="relative flex items-center justify-center min-h-screen p-4">
        <div class="relative ds-panel-floating max-w-[440px] w-full overflow-hidden animate-modal-in">
          
          <!-- Close Button - Floating -->
          <button 
            id="newsletter-close-button" 
            class="absolute top-4 right-4 z-10 w-8 h-8 flex items-center justify-center rounded-full bg-surface-container-high hover:bg-surface-container-highest text-on-surface-variant hover:text-on-surface transition-all cursor-pointer border-0"
            aria-label={app.layout.ariaCloseNewsletterModal}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
          
          <!-- Header with Icon — signature gradient (DESIGN.md §2) -->
          <div class="bg-cta-primary-br px-8 pt-8 pb-6 text-center">
            <div class="w-16 h-16 bg-white/20 backdrop-blur-sm rounded-2xl flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-on-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <h2 class="text-2xl font-bold font-headline text-on-primary mb-2">{app.layout.newsletterModalTitle}</h2>
            <p class="text-on-primary/90 text-sm leading-relaxed">
              {app.layout.newsletterModalSubtitle}
            </p>
          </div>
          
          <!-- Form Body -->
          <div class="px-8 py-6 bg-surface-container-lowest">
            <form id="newsletter-form" class="space-y-4">
              <!-- Email Field -->
              <div>
                <label for="newsletter-email" class="block text-sm font-medium text-on-surface-variant mb-1.5">
                  {app.layout.newsletterEmailLabel}
                </label>
                <input 
                  type="email" 
                  id="newsletter-email" 
                  name="email"
                  required
                  class="ds-input"
                  placeholder={app.layout.newsletterEmailPlaceholder}
                />
              </div>
              
              <!-- Name Field -->
              <div>
                <label for="newsletter-name" class="block text-sm font-medium text-on-surface-variant mb-1.5">
                  {app.layout.newsletterNameLabel}
                </label>
                <input 
                  type="text" 
                  id="newsletter-name" 
                  name="name"
                  class="ds-input"
                  placeholder={app.layout.newsletterNamePlaceholder}
                />
              </div>
              
              <!-- Privacy Checkbox - Compact -->
              <div class="flex items-start pt-1">
                <input 
                  type="checkbox" 
                  id="newsletter-privacy" 
                  name="privacy"
                  required
                  class="mt-0.5 h-4 w-4 rounded text-primary focus:ring-primary border-0 cursor-pointer accent-primary"
                />
                <label for="newsletter-privacy" class="ml-2.5 text-xs leading-relaxed text-on-surface-variant">
                  {app.layout.newsletterPrivacyPrefix}<a href="/privasidadi" class="text-primary hover:underline">{app.layout.newsletterPrivacyLink}</a>{app.layout.newsletterPrivacyMid}<a href="/termus" class="text-primary hover:underline">{app.layout.newsletterTermsLink}</a>
                </label>
              </div>
              
              <!-- Honeypot -->
              <input 
                type="text" 
                name="honeypot" 
                id="newsletter-honeypot" 
                style="position: absolute; left: -9999px; opacity: 0;" 
                tabindex="-1" 
                autocomplete="off"
                aria-hidden="true"
              />
              
              <!-- Submit — primary gradient CTA -->
              <button 
                type="submit" 
                class="w-full ds-btn-primary px-6 py-3 text-sm flex items-center justify-center gap-2"
              >
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                {app.layout.newsletterSubmit}
              </button>
            </form>
            
            <!-- Footer Note - Compact -->
            <p class="text-xs text-center text-on-surface-variant mt-4 flex items-center justify-center gap-1">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              {app.layout.newsletterFooterNote}
            </p>
          </div>
        </div>
      </div>
    </div>
    
    {
      ENABLE_LIGHTBOX && (
        <script src={getStaticFilePath('/scripts/fslightbox.js')} />
      )
    }
    
    <!-- Mobile Menu & Newsletter Modal JavaScript -->
    <script define:vars={{ newsletterApiUrl, newsletterScript: app.scripts.newsletterModal }}>
      document.addEventListener('DOMContentLoaded', function() {
        // Newsletter API configuration
        const API_BASE_URL = newsletterApiUrl || '';
        
        // 🔒 CSRF Protection: Helper function to get CSRF token
        async function getCsrfToken() {
          try {
            const apiUrl = API_BASE_URL ? `${API_BASE_URL}/api/csrf-token` : '/api/csrf-token';
            const response = await fetch(apiUrl, {
              credentials: 'include'  // Important for cookies
            });
            if (!response.ok) throw new Error('Failed to get CSRF token');
            const data = await response.json();
            return data.csrfToken;
          } catch (error) {
            console.error('CSRF token error:', error);
            return null;
          }
        }

        const OAUTH_NEWSLETTER_USER_KEY = 'ligadu_oauth_newsletter_user_id';

        function userShouldSkipNewsletterPrompts() {
          if (localStorage.getItem('newsletter_subscribed') === 'true') return true;
          if (window.Clerk && window.Clerk.user) return true;
          return false;
        }

        function waitForClerkLoaded(timeoutMs) {
          return new Promise(function (resolve) {
            const start = Date.now();
            function tick() {
              if (window.Clerk && window.Clerk.loaded) {
                resolve();
                return;
              }
              if (Date.now() - start > timeoutMs) {
                resolve();
                return;
              }
              setTimeout(tick, 50);
            }
            tick();
          });
        }

        async function trySubscribeFromClerkUser() {
          const clerk = window.Clerk;
          if (!clerk || !clerk.user) return;
          const u = clerk.user;
          const email = u.primaryEmailAddress && u.primaryEmailAddress.emailAddress;
          if (!email) return;
          if (localStorage.getItem(OAUTH_NEWSLETTER_USER_KEY) === u.id) return;
          const csrfToken = await getCsrfToken();
          if (!csrfToken) return;
          try {
            const apiUrl = API_BASE_URL ? `${API_BASE_URL}/api/subscribe` : '/api/subscribe';
            const response = await fetch(apiUrl, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': csrfToken,
              },
              credentials: 'include',
              body: JSON.stringify({
                email,
                name:
                  [u.firstName, u.lastName].filter(Boolean).join(' ').trim() ||
                  (u.fullName || '').trim() ||
                  '',
                privacy: true,
                honeypot: '',
              }),
            });
            const data = await response.json();
            if (response.ok && data.success) {
              localStorage.setItem('newsletter_subscribed', 'true');
              localStorage.setItem(OAUTH_NEWSLETTER_USER_KEY, u.id);
              if (typeof window.umami !== 'undefined') {
                window.umami.track('newsletter_subscribed', {
                  source: 'oauth_login',
                  already_subscribed: data.alreadySubscribed || false,
                });
              }
            }
          } catch (err) {
            console.error('OAuth newsletter subscribe error:', err);
          }
        }

        function wireClerkNewsletterHook() {
          waitForClerkLoaded(20000).then(function () {
            if (!window.Clerk) return;
            window.Clerk.addListener(function () {
              if (window.Clerk.user) {
                trySubscribeFromClerkUser();
                if (newsletterModal && !newsletterModal.classList.contains('hidden')) {
                  closeNewsletterModal();
                }
              } else {
                localStorage.removeItem(OAUTH_NEWSLETTER_USER_KEY);
              }
            });
            if (window.Clerk.user) {
              trySubscribeFromClerkUser();
            }
          });
        }
        
        // Mobile Menu Elements
        const mobileMenuButton = document.getElementById('mobile-menu-button');
        const mobileCloseButton = document.getElementById('mobile-close-button');
        const mobileDrawer = document.getElementById('mobile-drawer');
        const mobileOverlay = document.getElementById('mobile-overlay');
        
        // Newsletter Modal Elements
        const newsletterModal = document.getElementById('newsletter-modal');
        const newsletterOverlay = document.getElementById('newsletter-overlay');
        const newsletterCloseButton = document.getElementById('newsletter-close-button');
        const newsletterForm = document.getElementById('newsletter-form');
        const ctaButtons = document.querySelectorAll('.newsletter-btn');
        const footerNewsletterBtn = document.getElementById('footer-newsletter-btn');
        const mainHeader = document.getElementById('main-header');
        
        // Mobile Menu Functions
        function openMobileMenu() {
          const drawer = document.getElementById('mobile-drawer');
          const overlay = document.getElementById('mobile-overlay');
          
          // Enable pointer events
          drawer.style.pointerEvents = 'auto';
          overlay.style.pointerEvents = 'auto';
          
          // Show overlay
          overlay.classList.remove('opacity-0');
          overlay.classList.add('opacity-100');
          
          // Slide in drawer
          drawer.classList.remove('-translate-x-full');
          drawer.classList.add('translate-x-0');
          
          mobileMenuButton.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
          
          // 📊 TRACK: Mobile menu opened
          if (typeof window.umami !== 'undefined') {
            window.umami.track('menu_opened', { device: 'mobile' });
          }
        }
        
        function closeMobileMenu() {
          const drawer = document.getElementById('mobile-drawer');
          const overlay = document.getElementById('mobile-overlay');
          
          // Slide out drawer
          drawer.classList.remove('translate-x-0');
          drawer.classList.add('-translate-x-full');
          
          // Hide overlay
          overlay.classList.remove('opacity-100');
          overlay.classList.add('opacity-0');
          
          // Disable pointer events after animation
          setTimeout(() => {
            drawer.style.pointerEvents = 'none';
            overlay.style.pointerEvents = 'none';
          }, 300);
          
          mobileMenuButton.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }
        
        // Newsletter tracking variables
        let modalOpenTime = 0;
        let currentTrigger = 'unknown';
        const pageStartTime = Date.now();
        
        // Newsletter Modal Functions
        function openNewsletterModal(trigger = 'unknown') {
          if (userShouldSkipNewsletterPrompts()) return;
          currentTrigger = trigger;
          modalOpenTime = Date.now();
          
          newsletterModal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          
          // 📊 TRACK: Newsletter modal opened
          if (typeof window.umami !== 'undefined') {
            const articleTitle = document.querySelector('article h1')?.textContent?.trim();
            window.umami.track('newsletter_modal_opened', {
              trigger: trigger,
              seconds_on_page: Math.round((Date.now() - pageStartTime) / 1000),
              article: articleTitle || 'homepage'
            });
          }
          
          // Focus on email input
          setTimeout(() => {
            document.getElementById('newsletter-email').focus();
          }, 100);
        }
        
        function closeNewsletterModal() {
          const timeOpen = modalOpenTime > 0 ? Math.round((Date.now() - modalOpenTime) / 1000) : 0;
          const emailInput = document.getElementById('newsletter-email');
          const formTouched = emailInput && emailInput.value.length > 0;
          
          // 📊 TRACK: Modal dismissed (only if it was opened)
          if (typeof window.umami !== 'undefined' && modalOpenTime > 0) {
            const articleTitle = document.querySelector('article h1')?.textContent?.trim();
            window.umami.track('newsletter_modal_dismissed', {
              seconds_open: timeOpen,
              had_interaction: formTouched,
              article: articleTitle || 'homepage'
            });
          }
          
          newsletterModal.classList.add('hidden');
          document.body.style.overflow = '';
          // Reset form
          newsletterForm.reset();
          modalOpenTime = 0;
        }

        wireClerkNewsletterHook();

        function setupLigaduAuthChrome() {
          function syncAuthPanels() {
            var c = window.Clerk;
            if (!c || !c.loaded) return;
            var signedOut = document.querySelectorAll('.ligadu-auth-when-signed-out');
            var signedIn = document.querySelectorAll('.ligadu-auth-when-signed-in');
            if (c.user) {
              signedOut.forEach(function (el) {
                el.classList.add('ligadu-auth-hide');
              });
              signedIn.forEach(function (el) {
                el.classList.remove('ligadu-auth-hide');
              });
            } else {
              signedIn.forEach(function (el) {
                el.classList.add('ligadu-auth-hide');
              });
              signedOut.forEach(function (el) {
                el.classList.remove('ligadu-auth-hide');
              });
            }
          }

          document.body.addEventListener(
            'click',
            function (e) {
              var t = e.target;
              if (!(t instanceof Element)) return;
              var signInBtn = t.closest('.ligadu-open-sign-in');
              var signUpBtn = t.closest('.ligadu-open-sign-up');
              if (!signInBtn && !signUpBtn) return;
              var c = window.Clerk;
              if (!c) return;
              if (signInBtn && typeof c.openSignIn === 'function') {
                e.preventDefault();
                c.openSignIn({});
              } else if (signUpBtn && typeof c.openSignUp === 'function') {
                e.preventDefault();
                c.openSignUp({});
              }
            },
            true
          );

          waitForClerkLoaded(30000).then(function () {
            if (!window.Clerk) return;
            syncAuthPanels();
            window.Clerk.addListener(syncAuthPanels);
          });
        }
        setupLigaduAuthChrome();
        
        // Mobile Menu Event Listeners
        mobileMenuButton.addEventListener('click', openMobileMenu);
        mobileCloseButton.addEventListener('click', closeMobileMenu);
        mobileOverlay.addEventListener('click', closeMobileMenu);
        
        // Newsletter Modal Event Listeners
        ctaButtons.forEach(button => {
          button.addEventListener('click', function(e) {
            e.preventDefault();
            openNewsletterModal('cta_click');
          });
        });
        
        // Footer newsletter button
        if (footerNewsletterBtn) {
          footerNewsletterBtn.addEventListener('click', function(e) {
            e.preventDefault();
            openNewsletterModal();
          });
        }
        
        newsletterCloseButton.addEventListener('click', closeNewsletterModal);
        newsletterOverlay.addEventListener('click', closeNewsletterModal);
        
        // Newsletter Form Submission
        newsletterForm.addEventListener('submit', async function(e) {
          e.preventDefault();
          
          const email = document.getElementById('newsletter-email').value;
          const name = document.getElementById('newsletter-name').value;
          const privacy = document.getElementById('newsletter-privacy').checked;
          const honeypot = document.getElementById('newsletter-honeypot').value;
          const submitButton = newsletterForm.querySelector('button[type="submit"]');
          
          if (!privacy) {
            showNotification(newsletterScript.privacyRequired, 'error');
            return;
          }
          
          // 🔒 Get CSRF token before submitting
          const csrfToken = await getCsrfToken();
          if (!csrfToken) {
            showNotification(newsletterScript.csrfError, 'error');
            return;
          }
          
          // Show loading state
          if (submitButton) {
            submitButton.disabled = true;
            submitButton.innerHTML = newsletterScript.submitLoadingHtml;
          }
          
          try {
            const apiUrl = API_BASE_URL ? `${API_BASE_URL}/api/subscribe` : '/api/subscribe';
            const response = await fetch(apiUrl, {
              method: 'POST',
              headers: { 
                'Content-Type': 'application/json',
                'X-CSRF-Token': csrfToken  // 🔒 Include CSRF token
              },
              credentials: 'include',  // 🔒 Include cookies
              body: JSON.stringify({ 
                email, 
                name, 
                privacy,
                honeypot
              })
            });
            
            const data = await response.json();
            
            if (response.ok && data.success) {
              // 📊 TRACK: Newsletter subscription
              if (typeof window.umami !== 'undefined') {
                const articleTitle = document.querySelector('article h1')?.textContent?.trim();
                window.umami.track('newsletter_subscribed', {
                  source: 'modal',
                  article: articleTitle || 'homepage',
                  seconds_to_convert: Math.round((Date.now() - pageStartTime) / 1000),
                  already_subscribed: data.alreadySubscribed || false
                });
              }
              
              // Mark as subscribed in localStorage
              localStorage.setItem('newsletter_subscribed', 'true');
              
              // Show appropriate message
              if (data.alreadySubscribed) {
                showNotification(newsletterScript.successAlreadySubscribed, 'success');
              } else {
                showNotification(newsletterScript.successNew, 'success');
              }
              
              closeNewsletterModal();
            } else {
              showNotification(data.error || newsletterScript.errorGeneric, 'error');
            }
            
          } catch (error) {
            console.error('Subscription error:', error);
            if (error.message && error.message.includes('fetch')) {
              showNotification(newsletterScript.errorNetwork, 'error');
            } else {
              showNotification(newsletterScript.errorGeneric, 'error');
            }
          } finally {
            if (submitButton) {
              submitButton.disabled = false;
              submitButton.innerHTML = newsletterScript.submitButtonResetHtml;
            }
          }
        });
        
        // Notification system
        function showNotification(message, type = 'success') {
          const notification = document.createElement('div');
          notification.className = `notification notification-${type}`;
          notification.textContent = message;
          document.body.appendChild(notification);
          
          setTimeout(() => {
            notification.classList.add('show');
          }, 10);
          
          setTimeout(() => {
            notification.classList.remove('show');
            setTimeout(() => {
              document.body.removeChild(notification);
            }, 300);
          }, 3000);
        }
        
        // Newsletter trigger — exit intent only (desktop)
        const isDismissed = sessionStorage.getItem('newsletter_dismissed') === 'true';

        if (!isDismissed && !userShouldSkipNewsletterPrompts()) {
          let hasShownModal = false;

          document.addEventListener('mouseleave', function (e) {
            if (
              e.clientY < 10 &&
              !hasShownModal &&
              !userShouldSkipNewsletterPrompts()
            ) {
              hasShownModal = true;
              openNewsletterModal('exit_intent');
            }
          });
        }
        
        // Close modals on escape key
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') {
            if (!mobileDrawer.classList.contains('-translate-x-full')) {
              closeMobileMenu();
            }
            if (!newsletterModal.classList.contains('hidden')) {
              closeNewsletterModal();
            }
          }
        });
        
        // Close mobile menu on window resize to desktop
        window.addEventListener('resize', function() {
          if (window.innerWidth >= 768) {
            closeMobileMenu();
          }
        });
        
        // Sticky header scroll effect with smooth transition
        let ticking = false;
        window.addEventListener('scroll', function() {
          if (!ticking) {
            window.requestAnimationFrame(function() {
              const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
              
              if (scrollTop > 10) {
                mainHeader.classList.add('scrolled');
              } else {
                mainHeader.classList.remove('scrolled');
              }
              
              ticking = false;
            });
            ticking = true;
          }
        });
      });
    </script>
    
    <!-- 📊 UMAMI ANALYTICS TRACKING -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // Wait for Umami to load
        if (typeof window.umami === 'undefined') {
          console.warn('Umami not loaded - tracking disabled');
          return;
        }
        
        // Get article title if on article page
        const articleTitle = document.querySelector('article h1')?.textContent?.trim() || null;
        const isArticlePage = articleTitle !== null;
        
        // ========================================
        // 1. ARTICLE TRACKING
        // ========================================
        
        if (isArticlePage) {
          // Track article view
          window.umami.track('article_viewed', { 
            article: articleTitle 
          });
          
          // Scroll depth tracking
          const depthMarkers = { 25: false, 50: false, 75: false, 90: false, 100: false };
          let maxScrollDepth = 0;
          const pageLoadTime = Date.now();
          
          function calculateScrollDepth() {
            const articleEnd = document.getElementById('article-content-end');
            if (!articleEnd) {
              // Fallback to full page scroll
              const windowHeight = window.innerHeight;
              const documentHeight = document.body.scrollHeight;
              const scrollTop = window.scrollY;
              return Math.min(100, Math.round(((scrollTop + windowHeight) / documentHeight) * 100));
            }
            
            const articleRect = articleEnd.getBoundingClientRect();
            const viewportHeight = window.innerHeight;
            const scrollY = window.scrollY;
            const articleHeight = articleRect.top + scrollY;
            
            if (articleHeight <= viewportHeight) return 100; // Short article
            return Math.min(100, Math.max(0, Math.round((scrollY / (articleHeight - viewportHeight)) * 100)));
          }
          
          // Throttled scroll handler for depth tracking
          let scrollTimeout;
          window.addEventListener('scroll', () => {
            if (scrollTimeout) return;
            
            scrollTimeout = setTimeout(() => {
              const currentDepth = calculateScrollDepth();
              maxScrollDepth = Math.max(maxScrollDepth, currentDepth);
              
              // Track milestone depths
              Object.keys(depthMarkers).forEach(depth => {
                const depthNum = parseInt(depth);
                if (currentDepth >= depthNum && !depthMarkers[depth]) {
                  depthMarkers[depth] = true;
                  window.umami.track('article_scroll_depth', { 
                    depth: `${depth}%`, 
                    article: articleTitle 
                  });
                  
                  // Track completion at 90%
                  if (depthNum === 90) {
                    const timeSpent = Math.round((Date.now() - pageLoadTime) / 1000);
                    window.umami.track('article_completed', { 
                      article: articleTitle,
                      time_spent: timeSpent
                    });
                  }
                }
              });
              
              scrollTimeout = null;
            }, 200);
          });
          
          // Reading time tracking
          let startTime = Date.now();
          let isActive = true;
          let totalActiveTime = 0;
          
          // Track active vs idle time
          document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
              totalActiveTime += Date.now() - startTime;
              isActive = false;
            } else {
              startTime = Date.now();
              isActive = true;
            }
          });
          
          // Send reading time on page unload
          window.addEventListener('beforeunload', () => {
            const finalTime = isActive ? Date.now() - startTime : 0;
            const totalSeconds = Math.round((totalActiveTime + finalTime) / 1000);
            
            // Only track if user spent meaningful time (>5 seconds)
            if (totalSeconds > 5) {
              window.umami.track('reading_time', {
                article: articleTitle,
                seconds: totalSeconds,
                scroll_depth: maxScrollDepth,
                completed: maxScrollDepth >= 90
              });
            }
          });
        }
        
        // ========================================
        // 2. EXTERNAL LINK TRACKING
        // ========================================
        
        document.querySelectorAll('a[href^="http"]').forEach(link => {
          // Skip internal links
          if (link.href.includes(window.location.hostname)) return;
          
          link.addEventListener('click', () => {
            window.umami.track('external_link_clicked', {
              url: link.href,
              article: articleTitle || 'homepage'
            });
          });
        });
        
        // ========================================
        // 3. RELATED ARTICLES TRACKING
        // ========================================
        
        document.querySelectorAll('.related-articles a, [class*="related"] a').forEach(link => {
          link.addEventListener('click', () => {
            const toArticle = link.textContent?.trim() || link.href;
            if (articleTitle) {
              window.umami.track('related_article_clicked', {
                from: articleTitle,
                to: toArticle
              });
            }
          });
        });
        
        // ========================================
        // 4. SHARE BUTTON TRACKING
        // ========================================
        
        // Add data-share-platform attribute to your share buttons
        document.querySelectorAll('[data-share-platform]').forEach(button => {
          button.addEventListener('click', () => {
            const platform = button.getAttribute('data-share-platform');
            if (articleTitle) {
              window.umami.track('article_shared', {
                platform: platform,
                article: articleTitle
              });
            }
          });
        });
      });
    </script>
    </>
  )}
  </body>
</html>


