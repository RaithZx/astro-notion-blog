---
import type { Post } from '../lib/interfaces.ts'
import { getNavLink, getPostLink } from '../lib/blog-helpers.ts'
import PostCard from './PostCard.astro'
import uiStrings from '../locales/ui-strings.json'

export interface Props {
  posts: Post[]
  currentPostSlug: string
  title?: string
}

const { posts, currentPostSlug, title = uiStrings.app.post.relatedHeading } = Astro.props

const relatedPosts = posts
  .filter((p: Post) => p.Slug !== currentPostSlug)
  .slice(0, 3)
---

{
  relatedPosts.length > 0 && (
    <section class="mt-12 pb-16 px-0 border-t border-outline-variant/25 pt-10">
      <div class="flex flex-col sm:flex-row sm:justify-between sm:items-end gap-6 mb-12">
        <h2 class="font-headline text-xl font-bold text-outline m-0">{title}</h2>
        <a
          href={getNavLink('/')}
          class="inline-flex items-center gap-2 shrink-0 self-start sm:self-auto text-primary font-bold text-sm no-underline hover:underline underline-offset-4 decoration-tertiary"
        >
          {uiStrings.app.post.viewAllPosts}
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
        {relatedPosts.map((post: Post) => (
          <PostCard post={post} loading="lazy" />
        ))}
      </div>
    </section>
  )
}
