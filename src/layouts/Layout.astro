---
import '../styles/globals.css'
import { PUBLIC_GA_TRACKING_ID, ENABLE_LIGHTBOX, COMING_SOON, PUBLIC_ADSENSE_PUBLISHER_ID } from '../server-constants.ts'
import { getDatabase, getAllTags } from '../lib/notion/client.ts'
import { getNavLink, getTagLink, getStaticFilePath, filePath } from '../lib/blog-helpers.ts'
import '../styles/syntax-coloring.css'
import GoogleAnalytics from '../components/GoogleAnalytics.astro'
import SearchModal from '../components/SearchModal.astro'
import ComingSoon from '../components/ComingSoon.astro'
import SocialIcons from '../components/SocialIcons.astro'
import BackToTop from '../components/BackToTop.astro'
import { UserButton } from '@clerk/astro/components'
import uiStrings from '../locales/ui-strings.json'

export interface Props {
  title: string
  description: string
  path: string
  ogImage: string
  fullWidth?: boolean
  showCategoryNav?: boolean
  structuredData?: Record<string, unknown>[]
  noindex?: boolean
}

const app = uiStrings.app
const { title = app.site.defaultTitle, description = app.site.defaultDescription, path = '/', ogImage = '', fullWidth = false, showCategoryNav = true, structuredData = [], noindex = false } = Astro.props

const SITE_NAME = 'Ligadu'

/** Topic links — Notion tag names must match database (see getAllTags). */
const navTopicScience = getTagLink('Siênsia')
const navTopicTech = getTagLink('Tekinolojia')


// Check if we should show the coming soon page
const showComingSoon = COMING_SOON === 'true' || COMING_SOON === true

// Check if we're in production for analytics tracking
const isProduction = import.meta.env.PROD

const [database, allTags] = await Promise.all([getDatabase(), getAllTags()])

const activeTagMatch = path.match(/\/posts\/tag\/([^/]+)/)
const activeTag = activeTagMatch ? decodeURIComponent(activeTagMatch[1]) : null

const siteTitle = title ? `${title}` : app.site.defaultTitle
const siteDescription = description ? description : database.Description
const siteURL = new URL(getNavLink(path), Astro.site).toString()
const siteOGImage = new URL(
  getStaticFilePath('/ligadu_logo.png'),
  Astro.site
)

let coverImageURL: string
if (database.Cover) {
  if (database.Cover.Type === 'external') {
    coverImageURL = database.Cover.Url
  } else if (database.Cover.Type === 'file') {
    try {
      coverImageURL = filePath(new URL(database.Cover.Url))
    } catch {
      console.log('Invalid DB cover image URL: ', database.Cover?.Url)
    }
  }
}

let customIconURL: string = ''
if (database.Icon && database.Icon.Type === 'file') {
  try {
    customIconURL = filePath(new URL((database.Icon as any).Url))
  } catch {
    console.log('Invalid DB custom icon URL: ', (database.Icon as any)?.Url)
  }
}

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Ligadu',
  url: Astro.site,
  logo: siteOGImage.toString(),
  sameAs: ['https://linkedin.com/company/ligadu', 'https://www.instagram.com/ligadu.cv/'],
}

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Ligadu',
  url: Astro.site,
}

const allStructuredData = [organizationSchema, websiteSchema, ...structuredData]
---

<!DOCTYPE html>
<html lang="kea" prefix="og: https://ogp.me/ns#">
  <head>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('ligadu-theme')
          var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          if (theme === 'dark' || theme === 'dim') document.documentElement.classList.add('dark')
          if (theme === 'dim') document.documentElement.classList.add('dim')
        } catch (e) {}
      })()
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={noindex ? 'noindex' : 'max-image-preview:large'} />
    <meta charset="UTF-8" />
    <meta name="generator" content={Astro.generator} />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={siteURL} />
    <link rel="alternate" type="application/rss+xml" title="Ligadu" href={getStaticFilePath('/feed')} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/ligadu_logo.png" />
    <link rel="shortcut icon" href="/ligadu_logo.png" />
    <link rel="apple-touch-icon" href="/ligadu_logo.png" />
    <meta property="og:url" content={siteURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImage || siteOGImage} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage || siteOGImage} />
    <!-- Google Fonts: Inter for body/UI, Space Grotesk for headlines -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Space+Grotesk:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.4/dist/katex.min.css"
      integrity="sha384-vKruj+a13U8yHIkAyGgK1J3ArTLzrFGBbBc0tDp4ad/EyewESeXE/Iv67Aj8gKZ0"
      crossorigin="anonymous"
    />
	 <script
      defer
      src="https://stats.ligadu.com/script.js"
      data-website-id="3a333f58-6b50-445d-9ccf-3cec581bc5e9"
      data-do-not-track={isProduction ? "false" : "true"}
    ></script>
    {PUBLIC_ADSENSE_PUBLISHER_ID && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${PUBLIC_ADSENSE_PUBLISHER_ID}`}
        crossorigin="anonymous"
      ></script>
    )}
    {allStructuredData.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
  </head>
  <body>
    {showComingSoon ? (
      <ComingSoon />
    ) : (
      <>
    <GoogleAnalytics trackingId={PUBLIC_GA_TRACKING_ID} />
    
    <!-- Skip to content link for accessibility -->
    <a href="#main-content" class="skip-to-content">
      {app.layout.skipToContent}
    </a>
    
    <!-- Fixed glass nav: sticky breaks under some scroll parents; fixed + content offset is reliable -->
    <header
      id="main-header"
      class="fixed inset-x-0 top-0 z-[90] w-full border-0 isolate bg-surface/80 shadow-none supports-[backdrop-filter]:bg-surface/75 backdrop-blur-xl"
    >
      <nav class="flex justify-between items-center w-full px-8 py-4 max-w-7xl mx-auto">
        <div class="flex items-center gap-6 md:gap-12 min-w-0">
          <button
            id="mobile-menu-button"
            class="md:hidden bg-transparent border-0 text-on-surface-variant cursor-pointer p-2 hover:text-primary rounded transition-colors focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2 shrink-0"
            aria-label={app.layout.ariaOpenMobileMenu}
            aria-expanded="false"
            aria-controls="mobile-drawer"
            type="button"
          >
            <span class="material-symbols-outlined text-2xl leading-none" aria-hidden="true">menu</span>
          </button>

          <a
            href={getNavLink('/')}
            class="text-2xl font-black font-headline tracking-tight text-primary no-underline shrink-0"
          >
            {app.layout.brandName}
          </a>

        </div>

        <div class="flex items-center gap-4 md:gap-6 shrink-0">
          <a
            href={getNavLink('/posts/page/1')}
            class="hidden md:flex items-center gap-1.5 text-on-surface-variant hover:text-primary transition-colors font-medium text-sm no-underline"
          >
            <span class="material-symbols-outlined text-xl leading-none" aria-hidden="true">article</span>
            {app.layout.navPosts}
          </a>

          <button
            class="open-search-modal bg-transparent border-0 text-on-surface-variant hover:text-primary transition-colors p-1.5 rounded-full focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
            aria-label={app.layout.ariaOpenSearch}
            type="button"
          >
            <span class="material-symbols-outlined text-2xl leading-none" aria-hidden="true">search</span>
          </button>

          <button
            id="theme-toggle"
            class="bg-transparent border-0 text-on-surface-variant hover:text-primary transition-colors p-1.5 rounded-full focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
            aria-label={app.layout.ariaToggleDarkModeToDark}
            data-label-to-dark={app.layout.ariaToggleDarkModeToDark}
            data-label-to-dim={app.layout.ariaToggleDarkModeToDim}
            data-label-to-light={app.layout.ariaToggleDarkModeToLight}
            type="button"
          >
            <span id="theme-toggle-icon" class="material-symbols-outlined text-2xl leading-none" aria-hidden="true">dark_mode</span>
          </button>

          <div class="ligadu-auth-when-signed-out flex items-center">
            <button
              type="button"
              class="ligadu-open-sign-in bg-primary-container text-on-primary-container px-5 py-2 rounded-full font-bold text-sm transition-transform duration-200 active:scale-95 border-0 cursor-pointer"
            >
              {app.layout.authSignIn}
            </button>
          </div>

          <div class="ligadu-auth-when-signed-in flex items-center ligadu-auth-hide [&_.cl-userButtonBox]:shrink-0">
            <UserButton />
          </div>
        </div>
      </nav>
      
      <!-- Category strip -->
      {allTags.length > 0 && showCategoryNav && (
        <div class="border-t border-outline-variant/20 w-full">
          <div class="max-w-7xl mx-auto px-4 md:px-8 relative">
            <div class="flex gap-1 overflow-x-auto scrollbar-none py-1.5" data-scroll-fade style="scrollbar-width: none; -ms-overflow-style: none;">
              {allTags.map((tag) => (
                <a
                  href={getTagLink(tag.name)}
                  class={`shrink-0 text-xs font-medium px-3 py-1.5 rounded-full transition-colors no-underline whitespace-nowrap ${tag.name === activeTag ? 'bg-primary text-on-primary' : 'text-on-surface-variant hover:text-primary hover:bg-surface-container'}`}
                >
                  {tag.name}
                </a>
              ))}
            </div>
            <div class="scroll-fade-left absolute inset-y-0 left-0 w-8 bg-gradient-to-r from-surface/80 to-transparent pointer-events-none opacity-0 transition-opacity" aria-hidden="true" />
            <div class="scroll-fade-right absolute inset-y-0 right-0 w-8 bg-gradient-to-l from-surface/80 to-transparent pointer-events-none transition-opacity" aria-hidden="true" />
          </div>
        </div>
      )}

    </header>

    <!-- Mobile Navigation Drawer — outside <header> to escape backdrop-filter stacking context -->
    <div id="mobile-overlay" class="md:hidden fixed inset-0 bg-black/60 opacity-0 transition-opacity duration-300 pointer-events-none" style="z-index: 9998;"></div>

    <div id="mobile-drawer" class="md:hidden fixed top-0 left-0 w-[85vw] max-w-xs h-full transform -translate-x-full transition-transform duration-300 ease-in-out pointer-events-none flex flex-col bg-surface-container-lowest" style="z-index: 9999; box-shadow: 4px 0 24px rgba(0,0,0,0.12);">

      <!-- Drawer Header -->
      <div class="flex items-center justify-between px-5 py-4 border-b border-outline-variant/20">
        <a href={getNavLink('/')} class="text-xl font-black font-headline text-primary no-underline tracking-tight">{app.layout.brandName}</a>
        <button
          id="mobile-close-button"
          class="bg-surface-container-high border-0 text-on-surface-variant cursor-pointer w-8 h-8 flex items-center justify-center rounded-full hover:bg-surface-container-highest transition-colors"
          aria-label={app.layout.ariaCloseMobileMenu}
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <!-- Scrollable body -->
      <div class="flex-1 overflow-y-auto flex flex-col">

        <!-- Search bar -->
        <div class="px-4 pt-4 pb-2">
          <button
            class="open-search-modal w-full flex items-center gap-3 px-4 py-3 rounded-xl border-0 cursor-pointer text-left transition-colors bg-surface-container-low text-on-surface-variant"
            type="button"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <span class="text-sm">{app.layout.searchShort}...</span>
          </button>
        </div>

        <!-- Nav links -->
        <nav class="px-3 pt-2 pb-4">
          <p class="px-3 pt-2 pb-1 text-xs font-semibold uppercase tracking-widest text-on-surface-variant">Menu</p>
          <a href={getNavLink('/')} class="flex items-center gap-3 text-on-surface no-underline py-2.5 px-3 font-medium rounded-xl hover:bg-surface-container-low hover:text-primary transition-colors text-sm">
            <span class="material-symbols-outlined text-lg leading-none text-on-surface-variant" aria-hidden="true">home</span>
            {app.layout.navHome}
          </a>
          <a href={getNavLink('/posts/page/1')} class="flex items-center gap-3 text-on-surface no-underline py-2.5 px-3 font-medium rounded-xl hover:bg-surface-container-low hover:text-primary transition-colors text-sm">
            <span class="material-symbols-outlined text-lg leading-none text-on-surface-variant" aria-hidden="true">article</span>
            {app.layout.navPosts}
          </a>
          <a href={getNavLink('/kontaktu')} class="flex items-center gap-3 text-on-surface no-underline py-2.5 px-3 font-medium rounded-xl hover:bg-surface-container-low hover:text-primary transition-colors text-sm">
            <span class="material-symbols-outlined text-lg leading-none text-on-surface-variant" aria-hidden="true">mail</span>
            {app.layout.navContact}
          </a>
        </nav>

        <!-- Topics -->
        {allTags.length > 0 && (
          <div class="px-3 pb-4 border-t border-outline-variant/20 pt-4">
            <p class="px-3 pb-2 text-xs font-semibold uppercase tracking-widest text-on-surface-variant">Tópikus</p>
            <div class="flex flex-wrap gap-2 px-3">
              {allTags.slice(0, 6).map((tag) => (
                <a
                  href={getTagLink(tag.name)}
                  class="text-xs font-medium px-3 py-1.5 rounded-full no-underline transition-colors bg-surface-container-low text-on-surface-variant"
                >
                  {tag.name}
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Spacer -->
        <div class="flex-1" />

        <!-- Auth + Support footer -->
        <div class="px-4 pb-6 pt-4 border-t border-outline-variant/20 space-y-3">
          <div class="ligadu-auth-when-signed-out">
            <button
              type="button"
              class="ligadu-open-sign-in w-full ds-btn-primary py-3 text-sm"
            >
              {app.layout.authSignIn}
            </button>
          </div>
          <div class="ligadu-auth-when-signed-in ligadu-auth-hide flex items-center gap-3 px-1 py-2">
            <UserButton />
            <span class="text-sm font-medium text-on-surface">Minha conta</span>
          </div>
          <a
            href="https://buymeacoffee.com/Ligadu"
            target="_blank"
            rel="nofollow noopener noreferrer"
            class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl text-sm font-bold no-underline transition-opacity hover:opacity-90"
            style="background-color: #40DCA5; color: #000;"
          >
            {app.layout.drawerSupportCta}
          </a>

          <button
            id="theme-toggle-mobile"
            class="w-full flex items-center gap-3 py-2.5 px-3 rounded-xl text-sm font-medium text-on-surface hover:bg-surface-container-low transition-colors border-0 bg-transparent cursor-pointer"
            data-label-to-dark={app.layout.ariaToggleDarkModeToDark}
            data-label-to-dim={app.layout.ariaToggleDarkModeToDim}
            data-label-to-light={app.layout.ariaToggleDarkModeToLight}
            type="button"
          >
            <span id="theme-toggle-mobile-icon" class="material-symbols-outlined text-lg leading-none" aria-hidden="true">dark_mode</span>
            <span id="theme-toggle-mobile-label" class="theme-toggle-mobile-label">{app.layout.ariaToggleDarkModeToDark}</span>
          </button>
        </div>
      </div>
    </div>

    <div
      class:list={["min-h-screen bg-surface layout-page-shell", showCategoryNav ? "pt-[7rem] md:pt-[7.5rem]" : "pt-[4.75rem] md:pt-[5rem]"]}

      style="overflow-x: hidden; max-width: 100vw; position: relative; z-index: 0;"
    >
      <slot name="featured" />
      {fullWidth ? (
        <main
          id="main-content"
          class="w-full max-w-7xl mx-auto px-4 md:px-8 pt-6"
          style="overflow-x: hidden; min-width: 0; position: relative; z-index: 1;"
          tabindex="-1"
        >
          <slot name="main" />
        </main>
      ) : (
        <div class="flex flex-col lg:flex-row gap-6 lg:gap-8 px-5 py-8 max-sm:px-2.5 max-sm:py-5" style="max-width: 1200px; margin: 0 auto; overflow-x: hidden; position: relative; z-index: 1;">
          <main id="main-content" class="flex-1 lg:flex-[3] p-0 max-sm:p-5" style="max-width: 100%; overflow-x: hidden; min-width: 0; position: relative; z-index: 1;" tabindex="-1">
            <div class="main-content-wrapper" style="max-width: 100%;">
              <slot name="main" />
            </div>
          </main>

          <aside class="w-full lg:w-auto lg:flex-1 lg:max-w-xs p-0 lg:p-8 h-fit max-sm:p-5 empty:hidden">
            <slot name="aside" />
          </aside>
        </div>
      )}
    </div>

    <SearchModal />
    
    <BackToTop />
    
    <!-- Footer -->
    <footer class="bg-surface-container-low w-full mt-20 border-t border-outline-variant/30">
      <div class="max-w-7xl mx-auto px-8 py-16 grid grid-cols-1 md:grid-cols-4 gap-12">
        <!-- Brand Section -->
        <div class="space-y-6">
          <a href={getNavLink('/')} class="text-xl font-bold font-headline text-primary no-underline">{app.layout.brandName}</a>
          <p class="text-on-background/70 text-sm leading-relaxed">
            {app.layout.footerBrandBlurb}
          </p>
          <SocialIcons />
        </div>
        
        <!-- Navigation -->
        <div>
          <h4 class="font-bold font-headline mb-6 text-primary">{app.layout.footerNavHeading}</h4>
          <ul class="space-y-4 text-sm">
            <li><a href={getNavLink('/')} class="text-on-background/70 no-underline hover:underline decoration-tertiary decoration-2 underline-offset-4 transition-colors">{app.layout.navHome}</a></li>
            <li><a href={getNavLink('/posts/page/1')} class="text-on-background/70 no-underline hover:underline decoration-tertiary decoration-2 underline-offset-4 transition-colors">{app.layout.navPosts}</a></li>
            <li><a href={getNavLink('/kontaktu')} class="text-on-background/70 no-underline hover:underline decoration-tertiary decoration-2 underline-offset-4 transition-colors">{app.layout.navContact}</a></li>
            <li><a href="/privasidadi" class="text-on-background/70 no-underline hover:underline decoration-tertiary decoration-2 underline-offset-4 transition-colors">{app.layout.footerPrivacy}</a></li>
            <li><a href="/termus" class="text-on-background/70 no-underline hover:underline decoration-tertiary decoration-2 underline-offset-4 transition-colors" set:html={app.layout.footerTermsInnerHtml}></a></li>
          </ul>
        </div>
        
        <!-- Topics -->
        <div>
          <h4 class="font-bold font-headline mb-6 text-primary">{app.layout.footerTopicsHeading}</h4>
          <ul class="space-y-4 text-sm">
            <li><a href={navTopicScience} class="text-on-background/70 no-underline hover:underline decoration-tertiary decoration-2 underline-offset-4 transition-colors">{app.layout.navScience}</a></li>
            <li><a href={navTopicTech} class="text-on-background/70 no-underline hover:underline decoration-tertiary decoration-2 underline-offset-4 transition-colors">{app.layout.navTech}</a></li>
          </ul>
        </div>
        
        <!-- Newsletter + Support -->
        <div class="space-y-6">
          <div>
            <h4 class="font-bold font-headline mb-6 text-primary">{app.layout.footerNewsletterHeading}</h4>
            <div class="ligadu-auth-when-signed-out">
              <button
                type="button"
                class="ligadu-open-sign-in w-full ds-btn-primary py-3 text-sm"
              >
                {app.layout.footerNewsletterCta}
              </button>
            </div>
          </div>
          <div>
            <h4 class="font-bold font-headline mb-4 text-primary">{app.layout.footerSupportHeading}</h4>
            <a
              href="https://buymeacoffee.com/Ligadu"
              target="_blank"
              rel="nofollow noopener noreferrer"
              class="inline-flex items-center gap-2 w-full justify-center px-4 py-3 rounded-full text-sm font-bold no-underline transition-opacity duration-200 hover:opacity-90 active:scale-95"
              style="background-color: #40DCA5; color: #000000;"
            >
              {app.layout.footerSupportCta}
            </a>
          </div>
        </div>
      </div>
      
      <!-- Bottom Bar -->
      <div class="max-w-7xl mx-auto px-8 pb-8 text-center text-on-background/50 text-xs">
        © {new Date().getFullYear()} Ligadu
      </div>
    </footer>
    
    
    {
      ENABLE_LIGHTBOX && (
        <script src={getStaticFilePath('/scripts/fslightbox.js')} />
      )
    }
    
    <!-- Mobile Menu & Auth JavaScript -->
    <script>
      import { initScrollFade } from '../lib/scroll-fade-init'
      initScrollFade()

      document.addEventListener('DOMContentLoaded', function() {
        function waitForClerkLoaded(timeoutMs) {
          return new Promise(function (resolve) {
            const start = Date.now();
            function tick() {
              if (window.Clerk && window.Clerk.loaded) { resolve(); return; }
              if (Date.now() - start > timeoutMs) { resolve(); return; }
              setTimeout(tick, 50);
            }
            tick();
          });
        }

        function setupLigaduAuthChrome() {
          function syncAuthPanels() {
            var c = window.Clerk;
            if (!c || !c.loaded) return;
            var signedOut = document.querySelectorAll('.ligadu-auth-when-signed-out');
            var signedIn = document.querySelectorAll('.ligadu-auth-when-signed-in');
            if (c.user) {
              signedOut.forEach(function (el) { el.classList.add('ligadu-auth-hide'); });
              signedIn.forEach(function (el) { el.classList.remove('ligadu-auth-hide'); });
            } else {
              signedIn.forEach(function (el) { el.classList.add('ligadu-auth-hide'); });
              signedOut.forEach(function (el) { el.classList.remove('ligadu-auth-hide'); });
            }
          }
          document.body.addEventListener('click', function (e) {
            var t = e.target;
            if (!(t instanceof Element)) return;
            var signInBtn = t.closest('.ligadu-open-sign-in');
            var signUpBtn = t.closest('.ligadu-open-sign-up');
            if (!signInBtn && !signUpBtn) return;
            var c = window.Clerk;
            if (!c) return;
            var redirectUrl = window.location.href;
            if (signInBtn && typeof c.openSignIn === 'function') {
              e.preventDefault(); c.openSignIn({ afterSignInUrl: redirectUrl });
            } else if (signUpBtn && typeof c.openSignUp === 'function') {
              e.preventDefault(); c.openSignUp({ afterSignUpUrl: redirectUrl, afterSignInUrl: redirectUrl });
            }
          }, true);
          waitForClerkLoaded(30000).then(function () {
            if (!window.Clerk) return;
            syncAuthPanels();
            window.Clerk.addListener(syncAuthPanels);
          });
        }
        setupLigaduAuthChrome();

        const mobileMenuButton = document.getElementById('mobile-menu-button');
        const mobileCloseButton = document.getElementById('mobile-close-button');
        const mobileDrawer = document.getElementById('mobile-drawer');
        const mobileOverlay = document.getElementById('mobile-overlay');
        const mainHeader = document.getElementById('main-header');

        function openMobileMenu() {
          const drawer = document.getElementById('mobile-drawer');
          const overlay = document.getElementById('mobile-overlay');
          drawer.style.pointerEvents = 'auto';
          overlay.style.pointerEvents = 'auto';
          overlay.classList.remove('opacity-0');
          overlay.classList.add('opacity-100');
          drawer.classList.remove('-translate-x-full');
          drawer.classList.add('translate-x-0');
          mobileMenuButton.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
          if (typeof window.umami !== 'undefined') {
            window.umami.track('menu_opened', { device: 'mobile' });
          }
        }

        function closeMobileMenu() {
          const drawer = document.getElementById('mobile-drawer');
          const overlay = document.getElementById('mobile-overlay');
          drawer.classList.remove('translate-x-0');
          drawer.classList.add('-translate-x-full');
          overlay.classList.remove('opacity-100');
          overlay.classList.add('opacity-0');
          setTimeout(() => {
            drawer.style.pointerEvents = 'none';
            overlay.style.pointerEvents = 'none';
          }, 300);
          mobileMenuButton.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }

        mobileMenuButton.addEventListener('click', openMobileMenu);
        mobileCloseButton.addEventListener('click', closeMobileMenu);
        mobileOverlay.addEventListener('click', closeMobileMenu);

        document.querySelectorAll('.open-search-modal').forEach(function(el) {
          el.addEventListener('click', closeMobileMenu);
        });

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && !mobileDrawer.classList.contains('-translate-x-full')) {
            closeMobileMenu();
          }
        });

        window.addEventListener('resize', function() {
          if (window.innerWidth >= 768) closeMobileMenu();
        });

        let ticking = false;
        window.addEventListener('scroll', function() {
          if (!ticking) {
            window.requestAnimationFrame(function() {
              const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
              if (scrollTop > 10) {
                mainHeader.classList.add('scrolled');
              } else {
                mainHeader.classList.remove('scrolled');
              }
              ticking = false;
            });
            ticking = true;
          }
        });

        const themeToggle = document.getElementById('theme-toggle');
        const themeToggleIcon = document.getElementById('theme-toggle-icon');
        const themeToggleMobile = document.getElementById('theme-toggle-mobile');
        const themeToggleMobileIcon = document.getElementById('theme-toggle-mobile-icon');
        const themeToggleMobileLabel = document.getElementById('theme-toggle-mobile-label');
        const THEME_ORDER = ['light', 'dark', 'dim'];
        const THEME_ICON = { light: 'dark_mode', dark: 'bedtime', dim: 'light_mode' };
        function getTheme() {
          var el = document.documentElement;
          return el.classList.contains('dim') ? 'dim' : el.classList.contains('dark') ? 'dark' : 'light';
        }
        function applyTheme(theme) {
          var el = document.documentElement;
          el.classList.toggle('dark', theme === 'dark' || theme === 'dim');
          el.classList.toggle('dim', theme === 'dim');
          try { localStorage.setItem('ligadu-theme', theme); } catch (e) {}
          updateThemeToggleUI();
        }
        function updateThemeToggleUI() {
          var theme = getTheme();
          var next = THEME_ORDER[(THEME_ORDER.indexOf(theme) + 1) % THEME_ORDER.length];
          var icon = THEME_ICON[theme];
          var dataKey = 'labelTo' + next.charAt(0).toUpperCase() + next.slice(1);
          if (themeToggle) {
            themeToggle.setAttribute('aria-label', themeToggle.dataset[dataKey]);
          }
          if (themeToggleIcon) themeToggleIcon.textContent = icon;
          if (themeToggleMobileIcon) themeToggleMobileIcon.textContent = icon;
          if (themeToggleMobileLabel && themeToggleMobile) themeToggleMobileLabel.textContent = themeToggleMobile.dataset[dataKey];
        }
        function cycleTheme() {
          var theme = getTheme();
          applyTheme(THEME_ORDER[(THEME_ORDER.indexOf(theme) + 1) % THEME_ORDER.length]);
        }
        updateThemeToggleUI();
        if (themeToggle) themeToggle.addEventListener('click', cycleTheme);
        if (themeToggleMobile) themeToggleMobile.addEventListener('click', cycleTheme);
      });
    </script>

    <!-- 🔒 COPY PROTECTION DETERRENT -->
    <script>
      (function() {
        // Block right-click context menu
        document.addEventListener('contextmenu', function(e) {
          // Allow on form inputs
          if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
          e.preventDefault();
        });
        
        // Block copy/cut events
        document.addEventListener('copy', function(e) {
          if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
          e.preventDefault();
        });
        
        document.addEventListener('cut', function(e) {
          if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
          e.preventDefault();
        });
        
        // Block drag start (prevents drag-select-copy)
        document.addEventListener('dragstart', function(e) {
          if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
          e.preventDefault();
        });
        
        // Block common keyboard shortcuts for copy
        document.addEventListener('keydown', function(e) {
          // Allow in form fields
          if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
          
          // Block Ctrl+C, Ctrl+X, Ctrl+A, Ctrl+U (view source)
          if ((e.ctrlKey || e.metaKey) && ['c', 'x', 'a', 'u'].includes(e.key.toLowerCase())) {
            e.preventDefault();
          }
          
          // Block F12 (dev tools) and Ctrl+Shift+I/J/C
          if (e.key === 'F12') {
            e.preventDefault();
          }
          if ((e.ctrlKey || e.metaKey) && e.shiftKey && ['i', 'j', 'c'].includes(e.key.toLowerCase())) {
            e.preventDefault();
          }
        });
      })();
    </script>
    
    <!-- 📊 UMAMI ANALYTICS TRACKING -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // Wait for Umami to load
        if (typeof window.umami === 'undefined') {
          console.warn('Umami not loaded - tracking disabled');
          return;
        }
        
        // Get article title if on article page
        const articleTitle = document.querySelector('article h1')?.textContent?.trim() || null;
        const isArticlePage = articleTitle !== null;
        
        // ========================================
        // 1. ARTICLE TRACKING
        // ========================================
        
        if (isArticlePage) {
          // Track article view
          window.umami.track('article_viewed', { 
            article: articleTitle 
          });
          
          // Scroll depth tracking
          const depthMarkers = { 25: false, 50: false, 75: false, 90: false, 100: false };
          let maxScrollDepth = 0;
          const pageLoadTime = Date.now();
          
          function calculateScrollDepth() {
            const articleEnd = document.getElementById('article-content-end');
            if (!articleEnd) {
              // Fallback to full page scroll
              const windowHeight = window.innerHeight;
              const documentHeight = document.body.scrollHeight;
              const scrollTop = window.scrollY;
              return Math.min(100, Math.round(((scrollTop + windowHeight) / documentHeight) * 100));
            }
            
            const articleRect = articleEnd.getBoundingClientRect();
            const viewportHeight = window.innerHeight;
            const scrollY = window.scrollY;
            const articleHeight = articleRect.top + scrollY;
            
            if (articleHeight <= viewportHeight) return 100; // Short article
            return Math.min(100, Math.max(0, Math.round((scrollY / (articleHeight - viewportHeight)) * 100)));
          }
          
          // Throttled scroll handler for depth tracking
          let scrollTimeout;
          window.addEventListener('scroll', () => {
            if (scrollTimeout) return;
            
            scrollTimeout = setTimeout(() => {
              const currentDepth = calculateScrollDepth();
              maxScrollDepth = Math.max(maxScrollDepth, currentDepth);
              
              // Track milestone depths
              Object.keys(depthMarkers).forEach(depth => {
                const depthNum = parseInt(depth);
                if (currentDepth >= depthNum && !depthMarkers[depth]) {
                  depthMarkers[depth] = true;
                  window.umami.track('article_scroll_depth', { 
                    depth: `${depth}%`, 
                    article: articleTitle 
                  });
                  
                  // Track completion at 90%
                  if (depthNum === 90) {
                    const timeSpent = Math.round((Date.now() - pageLoadTime) / 1000);
                    window.umami.track('article_completed', { 
                      article: articleTitle,
                      time_spent: timeSpent
                    });
                  }
                }
              });
              
              scrollTimeout = null;
            }, 200);
          });
          
          // Reading time tracking
          let startTime = Date.now();
          let isActive = true;
          let totalActiveTime = 0;
          
          // Track active vs idle time
          document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
              totalActiveTime += Date.now() - startTime;
              isActive = false;
            } else {
              startTime = Date.now();
              isActive = true;
            }
          });
          
          // Send reading time on page unload
          window.addEventListener('beforeunload', () => {
            const finalTime = isActive ? Date.now() - startTime : 0;
            const totalSeconds = Math.round((totalActiveTime + finalTime) / 1000);
            
            // Only track if user spent meaningful time (>5 seconds)
            if (totalSeconds > 5) {
              window.umami.track('reading_time', {
                article: articleTitle,
                seconds: totalSeconds,
                scroll_depth: maxScrollDepth,
                completed: maxScrollDepth >= 90
              });
            }
          });
        }
        
        // ========================================
        // 2. EXTERNAL LINK TRACKING
        // ========================================
        
        document.querySelectorAll('a[href^="http"]').forEach(link => {
          // Skip internal links
          if (link.href.includes(window.location.hostname)) return;
          
          link.addEventListener('click', () => {
            window.umami.track('external_link_clicked', {
              url: link.href,
              article: articleTitle || 'homepage'
            });
          });
        });
        
        // ========================================
        // 3. RELATED ARTICLES TRACKING
        // ========================================
        
        document.querySelectorAll('.related-articles a, [class*="related"] a').forEach(link => {
          link.addEventListener('click', () => {
            const toArticle = link.textContent?.trim() || link.href;
            if (articleTitle) {
              window.umami.track('related_article_clicked', {
                from: articleTitle,
                to: toArticle
              });
            }
          });
        });
        
        // ========================================
        // 4. SHARE BUTTON TRACKING
        // ========================================
        
        // Add data-share-platform attribute to your share buttons
        document.querySelectorAll('[data-share-platform]').forEach(button => {
          button.addEventListener('click', () => {
            const platform = button.getAttribute('data-share-platform');
            if (articleTitle) {
              window.umami.track('article_shared', {
                platform: platform,
                article: articleTitle
              });
            }
          });
        });
      });
    </script>
    </>
  )}
