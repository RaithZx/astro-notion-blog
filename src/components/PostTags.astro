---
import type { Post, SelectProperty } from '../lib/interfaces.ts'
import CategoryPill from './CategoryPill.astro'

export interface Props {
  post: Post
  enableLink?: boolean
}

const { post, enableLink = true } = Astro.props
---

<div class="flex flex-wrap gap-2">
  {post.Tags && post.Tags.length > 0 && post.Tags.map((tag: SelectProperty) => (
    <CategoryPill name={tag.name} link={enableLink} />
  ))}
</div>
