---
export interface Props {
  title: string
  path: string
  description?: string
  variant?: 'inline' | 'compact'
}

const { title, path, description = '', variant = 'inline' } = Astro.props
const isCompact = variant === 'compact'

const iconBase =
  'flex items-center justify-center rounded-full bg-surface-container-low text-primary transition-all cursor-pointer no-underline hover:bg-primary hover:text-on-primary hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2'
const iconSize = isCompact ? 'w-9 h-9 sm:w-10 sm:h-10' : 'w-10 h-10'
---

<div
  class:list={['flex items-center', isCompact ? 'gap-2' : 'gap-4 py-4']}
  data-title={title}
  data-path={path}
  data-description={description}
>
  {!isCompact && <span class="text-sm font-medium text-on-surface-variant whitespace-nowrap">Partilha:</span>}
  <div class:list={['flex items-center gap-2']}>
    <a
      href="#"
      target="_blank"
      rel="noopener noreferrer"
      class:list={['share-icon share-twitter', iconBase, iconSize]}
      aria-label="Partilha na Twitter"
      title="Twitter"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path>
      </svg>
    </a>
    <a
      href="#"
      target="_blank"
      rel="noopener noreferrer"
      class:list={['share-icon share-facebook', iconBase, iconSize]}
      aria-label="Partilha na Facebook"
      title="Facebook"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
      </svg>
    </a>
    <a
      href="#"
      target="_blank"
      rel="noopener noreferrer"
      class:list={['share-icon share-whatsapp', iconBase, iconSize]}
      aria-label="Partilha na WhatsApp"
      title="WhatsApp"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path>
        <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"></path>
      </svg>
    </a>
    <button
      class:list={['share-icon share-copy border-0', iconBase, iconSize]}
      aria-label="Kopia link"
      title="Kopia link"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll('[data-title][data-path]').forEach((container) => {
    const title = container.getAttribute('data-title') || ''
    const path = container.getAttribute('data-path') || ''

    const fullUrl = window.location.origin + path
    const encodedTitle = encodeURIComponent(title)
    const encodedUrl = encodeURIComponent(fullUrl)

    const twitterLink = container.querySelector('.share-twitter') as HTMLAnchorElement | null
    if (twitterLink) {
      twitterLink.href = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`
    }

    const facebookLink = container.querySelector('.share-facebook') as HTMLAnchorElement | null
    if (facebookLink) {
      facebookLink.href = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`
    }

    const whatsappLink = container.querySelector('.share-whatsapp') as HTMLAnchorElement | null
    if (whatsappLink) {
      whatsappLink.href = `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`
    }

    const copyButton = container.querySelector('.share-copy') as HTMLButtonElement | null
    if (copyButton) {
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(fullUrl)

          const originalHTML = copyButton.innerHTML
          copyButton.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          `
          copyButton.classList.add('!bg-tertiary-fixed', '!text-on-tertiary-fixed')

          setTimeout(() => {
            copyButton.innerHTML = originalHTML
            copyButton.classList.remove('!bg-tertiary-fixed', '!text-on-tertiary-fixed')
          }, 2000)
        } catch (err) {
          console.error('Failed to copy:', err)
        }
      })
    }
  })
</script>
