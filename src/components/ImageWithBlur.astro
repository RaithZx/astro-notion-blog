---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

export interface Props {
  src: ImageMetadata | string
  alt: string
  width?: number
  height?: number
  class?: string
  loading?: 'lazy' | 'eager'
  aspectRatio?: string
  /** 'natural' renders the image at its own intrinsic ratio — no crop, no box. */
  fit?: 'cover' | 'contain' | 'natural'
  /** fill: stretch to cover the nearest relative ancestor — no aspect-ratio applied. */
  fill?: boolean
  /** Soft zoom on parent group hover */
  hoverZoom?: boolean
}

const {
  src,
  alt,
  width,
  height,
  class: className = '',
  loading = 'lazy',
  aspectRatio,
  fit = 'cover',
  fill = false,
  hoverZoom = false,
} = Astro.props

const isNatural = fit === 'natural'
const isEager = loading === 'eager'
const imageId = `img-${Math.random().toString(36).substr(2, 9)}`
const isString = typeof src === 'string'

const wrapperStyle = isNatural || fill
  ? ''
  : `aspect-ratio: ${aspectRatio || '16 / 9'};`
---

<div class:list={['image-blur-wrapper', className, { 'image-blur-wrapper-natural': isNatural, 'image-blur-wrapper-fill': fill }]} style={wrapperStyle}>
  <!-- Blur placeholder/skeleton (skipped for eager/LCP images — it would only delay paint) -->
  {!isEager && (
    <div class="image-blur-placeholder" data-placeholder-id={imageId}>
      <div class="skeleton-shimmer"></div>
    </div>
  )}

  <!-- Actual image -->
  <div class:list={['image-container', { 'image-container-natural': isNatural, 'image-container-eager': isEager }]} data-container-id={imageId}>
    {isString ? (
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        fetchpriority={isEager ? 'high' : 'auto'}
        class:list={['image-content', { 'image-content-natural': isNatural, 'image-content-zoom': hoverZoom }]}
        style={isNatural ? '' : `object-fit: ${fit};`}
        data-image-id={imageId}
      />
    ) : (
      <Image
        src={src}
        alt={alt}
        width={width || src.width}
        height={height || src.height}
        loading={loading}
        fetchpriority={isEager ? 'high' : 'auto'}
        class:list={['image-content', { 'image-content-natural': isNatural, 'image-content-zoom': hoverZoom }]}
        style={isNatural ? '' : `object-fit: ${fit};`}
        data-image-id={imageId}
      />
    )}
  </div>
</div>

<style>
  .image-blur-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #e2e8f0;
  }

  .image-blur-wrapper-natural {
    height: auto;
    overflow: visible;
    background-color: transparent;
  }

  .image-blur-wrapper-fill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: transparent;
  }

  .image-blur-wrapper-fill .image-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .image-blur-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      #e2e8f0 0%,
      #f1f5f9 50%,
      #e2e8f0 100%
    );
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    z-index: 1;
    transition: opacity 0.5s ease-out;
  }

  .image-blur-placeholder.loaded {
    opacity: 0;
    pointer-events: none;
  }

  /* Default: relative positioning for natural image flow (blog posts) */
  .image-container {
    position: relative;
    width: 100%;
    opacity: 0;
    transition: opacity 0.5s ease-in;
  }

  .image-container-natural {
    position: static;
    inset: auto;
    width: 100%;
    height: auto;
  }

  .image-container.loaded {
    opacity: 1;
  }

  /* Eager/LCP images must paint immediately — never gate visibility behind JS */
  .image-container-eager {
    opacity: 1;
  }

  .image-content {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .image-content-natural {
    height: auto;
  }

  :global(.group:hover) .image-content-zoom {
    transform: scale(1.07);
  }

  .image-content-zoom {
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.5s ease-in;
  }

  @keyframes shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }
</style>

<script define:vars={{ imageId }}>
  // Handle image load events for both regular img and Astro Image components
  (function() {
    const container = document.querySelector(`[data-container-id="${imageId}"]`)
    const placeholder = document.querySelector(`[data-placeholder-id="${imageId}"]`)
    const img = container?.querySelector('img')
    
    if (img && container && placeholder) {
      const handleLoad = () => {
        container.classList.add('loaded')
        placeholder.classList.add('loaded')
      }
      
      // Check if already loaded
      if (img.complete && img.naturalHeight !== 0) {
        handleLoad()
      } else {
        img.addEventListener('load', handleLoad)
        img.addEventListener('error', handleLoad)
      }
    }
  })()
</script>
