---
export const prerender = true

import type { SelectProperty } from '../../../../../lib/interfaces.ts'
import {
  getPostsByTagAndPage,
  getAllTags,
  getNumberOfPagesByTag,
  getPostCountByTag,
} from '../../../../../lib/notion/client.ts'
import Layout from '../../../../../layouts/Layout.astro'
import CategoryTagMain from '../../../../../components/CategoryTagMain.astro'
import uiStrings from '../../../../../locales/ui-strings.json'

export async function getStaticPaths() {
  const allTags = await getAllTags()

  let params: Array<{ params: { tag: string; page: string } }> = []

  await Promise.all(
    allTags.map((t: SelectProperty) => {
      return getNumberOfPagesByTag(t.name).then((numberOfPages: number) => {
        for (let i = 2; i <= numberOfPages; i++) {
          params.push({ params: { tag: t.name, page: i.toString() } })
        }
      })
    })
  )

  return params
}

const { tag, page } = Astro.params

const currentPage = parseInt(page, 10)
const brand = uiStrings.app.layout.brandName
const cp = uiStrings.app.categoryPage

const [posts, tags, numberOfPages, totalInTag] = await Promise.all([
  getPostsByTagAndPage(tag, currentPage),
  getAllTags(),
  getNumberOfPagesByTag(tag),
  getPostCountByTag(tag),
])
---

<Layout
  title={cp.titlePageTemplate.replace('{{tag}}', tag).replace('{{page}}', String(currentPage)).replace('{{brand}}', brand)}
  description={cp.descriptionTemplate.replace('{{tag}}', tag)}
  path={`/posts/tag/${tag}/page/${page}`}
  ogImage=""
  fullWidth={true}
  showCategoryNav={false}
>
  <div slot="main" class="w-full min-w-0">
    <CategoryTagMain
      tag={tag}
      posts={posts}
      currentPage={currentPage}
      numberOfPages={numberOfPages}
      totalInTag={totalInTag}
      allTags={tags}
    />
  </div>
</Layout>
