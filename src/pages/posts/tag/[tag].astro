---
export const prerender = true

import type { SelectProperty } from '../../../lib/interfaces.ts'
import { NUMBER_OF_POSTS_PER_PAGE } from '../../../server-constants.ts'
import {
  getPostsByTag,
  getAllTags,
  getNumberOfPagesByTag,
  getPostCountByTag,
} from '../../../lib/notion/client.ts'
import Layout from '../../../layouts/Layout.astro'
import CategoryTagMain from '../../../components/CategoryTagMain.astro'

export async function getStaticPaths() {
  const allTags = await getAllTags()
  return allTags.map((t: SelectProperty) => ({ params: { tag: t.name } }))
}

const { tag } = Astro.params

const [posts, tags, numberOfPages, totalInTag] = await Promise.all([
  getPostsByTag(tag, NUMBER_OF_POSTS_PER_PAGE),
  getAllTags(),
  getNumberOfPagesByTag(tag),
  getPostCountByTag(tag),
])
---

<Layout
  title={`${tag} | Ligadu`}
  description={`Artigus di ${tag}`}
  path={`/posts/tag/${tag}`}
  ogImage=""
  fullWidth={true}
  showCategoryNav={false}
>
  <div slot="main" class="w-full min-w-0">
    <CategoryTagMain
      tag={tag}
      posts={posts}
      currentPage={1}
      numberOfPages={numberOfPages}
      totalInTag={totalInTag}
      allTags={tags}
    />
  </div>
</Layout>
